# The disc image and what is extracted from it; only their checksums are
# tracked.
/rom/*
!/rom/pal/
/rom/pal/*
!/rom/pal/checksum.sha256
!/rom/pal/extracted.sha256

# Misc RE
/ps2/re/

# Non-essential tools
tools/ghidra

# Generated by the split and the build
/ps2/asm/
/build/

# The lock every build of the tree takes; see scripts/build/cmake.sh.
/.build.lock

# objdiff's configuration and progress report, generated by the build
/objdiff.json
/progress/

# Private retail assets used by CI and local progress reports
/.private/

# m2c context
ctx.c

# Python cache
**/__pycache__

# macOS
.DS_Store

# AI
AGENTS.md

# EE GCC toolchain and newlib headers, installed by scripts/build/setup_gcc.py
/tools/compilers/ee-gcc*/
/tools/newlib/
