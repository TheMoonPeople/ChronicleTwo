+def image_tag():
+    head = subprocess.run(["git", "-C", str(KZ), "rev-parse", "HEAD:image"], capture_output=True, text=True)
+    status = subprocess.run(["git", "-C", str(KZ), "status", "--porcelain", "--", "image"],
+                            capture_output=True, text=True)
+    if head.returncode != 0 or status.stdout.strip():
+        pytest.skip("image/ has uncommitted changes, so the image tag is dirty")
+    return head.stdout.strip()[:12]
+
+
+def persist_name(root):
+    path = str(root).replace("\\", "/")
+    if path[1:2] == ":":
+        path = path[0].upper() + path[1:]
+    return "kz-scratch-" + hashlib.sha256(path.encode("utf-8")).hexdigest()[:10]
+
+
+def test_linked_junction_target_is_mounted_under_its_name(pwsh, project):
+    if sys.platform != "win32":
+        pytest.skip("junctions are a Windows feature")
+    root, _ = project
+    target = root.parent / "other checkout" / "data"
+    target.mkdir(parents=True)
+    subprocess.run(["cmd", "/c", "mklink", "/J", str(root / "data"), str(target)],
+                   check=True, capture_output=True)
+    result, calls, windows_argv = run_kazarov(pwsh, project, "build", "ps2")
+    assert result.returncode == 0, result.stderr
+    run = container_run(calls)
+    mounts = [run[i + 1].lower() for i, arg in enumerate(run[:-1]) if arg == "-v"]
+    assert f"{target}:/work/scratch/data".lower() in mounts, mounts
+    assert f"{root}:/work/scratch".lower() in mounts, mounts
+
+
+def test_running_persistent_container_of_the_same_tag_is_exec_d(pwsh, project):
+    root, _ = project
+    result, calls, _ = run_kazarov(pwsh, project, "build", "ps2", inspect=f"true {image_tag()}")
+    assert result.returncode == 0, result.stderr
+    assert [call for call in calls if call[:1] == ["run"]] == []
+    (exec_call,) = [call for call in calls if call[:1] == ["exec"]]
+    assert exec_call[-5:] == [persist_name(root), "tools/kazarov/bin/kazarov", "--inside", "build", "ps2"]
+    assert exec_call[exec_call.index("-w") + 1] == "/work/scratch"
+
+
+def test_persistent_container_of_another_tag_falls_back_with_a_message(pwsh, project):
+    result, calls, _ = run_kazarov(pwsh, project, "build", "ps2", inspect="true 000000000000")
+    assert result.returncode == 0, result.stderr
+    assert container_run(calls)[0] == "run"
+    assert "kazarov up" in result.stderr
+
+
+def test_keep_persist_starts_the_container_before_exec(pwsh, project):
+    result, calls, _ = run_kazarov(pwsh, project, "build", "ps2", extra_env={"KZ_PERSIST": "1"})
+    assert result.returncode == 0, result.stderr
+    starts = [i for i, call in enumerate(calls) if call[:2] == ["run", "-d"]]
+    execs = [i for i, call in enumerate(calls) if call[:1] == ["exec"]]
+    assert len(starts) == 1 and len(execs) == 1 and starts[0] < execs[0], calls
+
+
