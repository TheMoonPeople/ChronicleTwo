+# The -v flags for each top-level junction or symlink whose target is a directory outside the root,
+# mounted at its own name under /work, as bin/kazarov mounts them.
+function Get-LinkedMounts([string]$Dir, [string]$Project) {
+    $mounts = @()
+    $prefix = $Dir + '\'
+    foreach ($entry in @(Get-ChildItem -LiteralPath $Dir -Directory)) {
+        if (-not $entry.LinkType) { continue }
+        $target = @($entry.Target) | Select-Object -First 1
+        if (-not $target) { continue }
+        $full = [System.IO.Path]::GetFullPath([string]$target).TrimEnd('\')
+        if ($full -eq $Dir -or $full.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { continue }
+        if (-not (Test-Path -LiteralPath $full -PathType Container)) { continue }
+        $mounts += '-v', "${full}:/work/$Project/$($entry.Name)"
+    }
+    $mounts
+}
+
+# kz-<project>-<10 hex digits of the sha256 of the root>. The root is hashed the way bin/kazarov's
+# kz_host_path writes it: forward slashes, upper-case drive letter.
+function Get-PersistName([string]$Dir, [string]$Project) {
+    $path = $Dir.Replace('\', '/')
+    if ($path -match '^[a-z]:') { $path = $path.Substring(0, 1).ToUpperInvariant() + $path.Substring(1) }
+    $sha = [System.Security.Cryptography.SHA256]::Create()
+    $hex = [BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($path))) -replace '-', ''
+    return "kz-$Project-$($hex.Substring(0, 10).ToLowerInvariant())"
+}
+
 function Invoke-Container([string]$Config, [string[]]$ContainerArgs) {
     if (-not $project) { Fail 'KZ_PROJECT is not set in kazarov.conf' }
 
@@ -150,15 +177,34 @@ function Invoke-Container([string]$Config, [string[]]$ContainerArgs) {
     if (-not (Test-Path -LiteralPath $kzDir)) { New-Item -ItemType Directory -Path $kzDir | Out-Null }
     $desc = 'run-' + [guid]::NewGuid().ToString('N') + '.txt'
 
-    $runArgs = @('run', '--rm', '--init',
-        '-v', "${Root}:/work/$project",
-        '-w', "/work/$project",
-        '-e', 'HOME=/tmp',
-        '-e', 'KZ_HOST_OS=windows',
-        '-e', 'CLEAN',
-        '-e', 'JOBS',
-        '-e', "KZ_RUN_OUT=.kazarov/$desc",
-        $imgId, 'tools/kazarov/bin/kazarov', '--inside', $Command)
+    $mounts = @('-v', "${Root}:/work/$project") + @(Get-LinkedMounts $Root $project)
+
+    # A dirty tag never reuses a container: its label cannot say which uncommitted files it was built from.
+    $pname = Get-PersistName $Root $project
+    $state = ''
+    if ($tag -ne 'dirty') {
+        $state = [string](& $bld container inspect -f '{{.State.Running}} {{index .Config.Labels "org.themoonpeople.kazarov.image"}}' $pname 2>$null | Select-Object -First 1)
+    }
+    if ($tag -ne 'dirty' -and $state -ne "true $tag" -and $env:KZ_PERSIST -eq '1') {
+        if ($state) { Invoke-Native $bld @('rm', '-f', $pname) | Out-Null }
+        Invoke-Native $bld (@('run', '-d', '--name', $pname, '--init',
+            '--label', "org.themoonpeople.kazarov.image=$tag", '-w', "/work/$project") + $mounts + @($imgId, 'sleep', 'infinity')) | Out-Null
+        if ($script:NativeExit -ne 0) { Fail 'cannot start the persistent container' }
+        $state = "true $tag"
+    }
+    $persistent = ($tag -ne 'dirty') -and ($state -eq "true $tag")
+    if ($state -like 'true *' -and -not $persistent) {
+        [Console]::Error.WriteLine("kazarov: $pname runs another image than $tag; run 'kazarov up' to replace it")
+    }
+
+    $envArgs = @('-e', 'HOME=/tmp', '-e', 'KZ_HOST_OS=windows', '-e', 'CLEAN', '-e', 'JOBS', '-e', "KZ_RUN_OUT=.kazarov/$desc")
+    if ($persistent) {
+        $runArgs = @('exec', '-w', "/work/$project") + $envArgs + @($pname)
+    }
+    else {
+        $runArgs = @('run', '--rm', '--init') + $mounts + @('-w', "/work/$project") + $envArgs + @($imgId)
+    }
+    $runArgs += 'tools/kazarov/bin/kazarov', '--inside', $Command
     if ($Config) { $runArgs += $Config }
     $runArgs += $ContainerArgs
     Invoke-Native $bld $runArgs
