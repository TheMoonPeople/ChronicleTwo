diff --git a/tests/test_kz_container.py b/tests/test_kz_container.py
new file mode 100644
index 0000000..a03f8cb
--- /dev/null
+++ b/tests/test_kz_container.py
@@ -0,0 +1,206 @@
+"""bin/kazarov container paths, run against a fake docker (and podman) that records its argv.
+
+Covers the mounts for linked top-level entries, kazarov up and down, the exec path into a running
+persistent container, KZ_PERSIST, and the number of runtime calls on the ordinary run path.
+"""
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+KZ = Path(__file__).resolve().parent.parent
+IMAGE_ID = "sha256:" + "cd" * 32
+CONF = """\
+KZ_PROJECT=scratch
+kz_config() { return 1; }
+"""
+
+FAKE_RUNTIME = """\
+#!/usr/bin/env python3
+import json
+import os
+import sys
+
+args = sys.argv[1:]
+with open(os.environ["FAKE_DOCKER_LOG"], "a", encoding="utf-8") as log:
+    log.write(json.dumps(args) + "\\n")
+state_path = os.environ["FAKE_DOCKER_STATE"]
+if args[:2] == ["image", "inspect"]:
+    print("%s")
+elif args[:1] == ["run"] and "-d" in args:
+    name = args[args.index("--name") + 1]
+    label = next(a.split("=", 1)[1] for a in args if a.startswith("org.themoonpeople.kazarov.image="))
+    with open(state_path, "w", encoding="utf-8") as state:
+        state.write(name + "\\n" + label + "\\n")
+elif args[:2] == ["container", "inspect"]:
+    if not os.path.exists(state_path):
+        sys.exit(1)
+    with open(state_path, encoding="utf-8") as state:
+        name, label = state.read().splitlines()
+    if args[-1] != name:
+        sys.exit(1)
+    print("true " + label)
+elif args[:1] == ["rm"] and os.path.exists(state_path):
+    os.remove(state_path)
+sys.exit(0)
+""" % IMAGE_ID
+
+
+def _git(cwd, *args):
+    subprocess.run(["git", "-C", str(cwd), *args], check=True, capture_output=True,
+                   env=dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t",
+                            GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t"))
+
+
+@pytest.fixture
+def project(tmp_path):
+    if shutil.which("git") is None:
+        pytest.skip("git is needed for a clean image tag")
+    root = tmp_path / "proj"
+    kz = root / "tools" / "kazarov"
+    shutil.copytree(KZ / "bin", kz / "bin")
+    shutil.copytree(KZ / "lib", kz / "lib")
+    (kz / "image").mkdir()
+    (kz / "image" / "Dockerfile").write_text("FROM scratch\n", encoding="utf-8")
+    _git(kz, "init", "-q")
+    _git(kz, "add", "image")
+    _git(kz, "commit", "-q", "-m", "image")
+
+    (root / "kazarov.conf").write_text(CONF, encoding="utf-8")
+    (root / "src").mkdir()
+    other = tmp_path / "other checkout"
+    (other / "data").mkdir(parents=True)
+    (other / "data" / "disc.bin").write_bytes(b"")
+    (root / "data").symlink_to(other / "data", target_is_directory=True)
+    (root / "inside-link").symlink_to(root / "src", target_is_directory=True)
+    (root / "dangling").symlink_to(tmp_path / "missing", target_is_directory=True)
+
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    for name in ("docker", "podman"):
+        tool = bin_dir / name
+        tool.write_text(FAKE_RUNTIME, encoding="utf-8")
+        tool.chmod(0o755)
+    return root, other, bin_dir
+
+
+def run(project, *args, builder="docker", env=None):
+    root, _, bin_dir = project
+    log = bin_dir.parent / "calls.log"
+    log.unlink(missing_ok=True)
+    full_env = dict(os.environ)
+    for key in ("REBUILD_IMAGE", "KZ_PERSIST", "KZ_INTERACTIVE", "CLEAN", "KZ_ENV_PASS", "KZ_RUN_OUT"):
+        full_env.pop(key, None)
+    full_env.update(PATH=f"{bin_dir}{os.pathsep}{os.environ['PATH']}", BUILDER=builder,
+                    FAKE_DOCKER_LOG=str(log), FAKE_DOCKER_STATE=str(bin_dir.parent / "state"))
+    full_env.update(env or {})
+    result = subprocess.run(["bash", str(root / "tools" / "kazarov" / "bin" / "kazarov"), *args],
+                            cwd=str(root), env=full_env, capture_output=True, text=True)
+    calls = []
+    if log.exists():
+        calls = [json.loads(line) for line in log.read_text(encoding="utf-8").splitlines()]
+    return result, calls
+
+
+def persist_name(root):
+    digest = hashlib.sha256(str(root.resolve()).encode()).hexdigest()
+    return f"kz-scratch-{digest[:10]}"
+
+
+def driver_path():
+    return "/work/scratch/tools/kazarov/bin/kazarov"
+
+
+def runs(calls):
+    return [call for call in calls if call[:1] == ["run"]]
+
+
+def test_shell_mounts_linked_targets_and_nothing_else(project):
+    root, other, _ = project
+    result, calls = run(project, "shell", "true")
+    assert result.returncode == 0, result.stderr
+    (run_call,) = runs(calls)
+    assert f"{root.resolve()}:/work/scratch" in run_call
+    assert f"{(other / 'data').resolve()}:/work/scratch/data" in run_call
+    joined = " ".join(run_call)
+    assert "/work/scratch/inside-link" not in joined
+    assert "/work/scratch/dangling" not in joined
+    assert "/work/scratch/src" not in joined
+    assert "/work/scratch/.kazarov" not in joined
+
+
+def test_podman_adds_the_selinux_label_to_linked_mounts(project):
+    root, other, _ = project
+    result, calls = run(project, "shell", "true", builder="podman")
+    assert result.returncode == 0, result.stderr
+    (run_call,) = runs(calls)
+    assert f"{(other / 'data').resolve()}:/work/scratch/data:Z" in run_call
+    assert f"{root.resolve()}:/work/scratch:Z" in run_call
+
+
+def test_the_ordinary_run_path_makes_three_runtime_calls(project):
+    result, calls = run(project, "shell", "true")
+    assert result.returncode == 0, result.stderr
+    assert [call[0] for call in calls] == ["container", "image", "run"]
+
+
+def test_the_exec_path_makes_no_image_lookup(project):
+    assert run(project, "up")[0].returncode == 0
+    result, calls = run(project, "shell", "true")
+    assert result.returncode == 0, result.stderr
+    assert [call[0] for call in calls] == ["container", "exec"]
+
+
+def test_up_starts_a_detached_long_lived_container(project):
+    root, other, _ = project
+    result, calls = run(project, "up")
+    assert result.returncode == 0, result.stderr
+    (up_call,) = runs(calls)
+    assert up_call[:3] == ["run", "-d", "--name"]
+    assert up_call[3] == persist_name(root)
+    assert "--init" in up_call
+    assert any(arg.startswith("org.themoonpeople.kazarov.image=") for arg in up_call)
+    assert f"{(other / 'data').resolve()}:/work/scratch/data" in up_call
+    assert up_call[-2:] == ["sleep", "infinity"]
+
+
+def test_shell_execs_into_the_running_container_of_the_same_tag(project):
+    root, _, _ = project
+    assert run(project, "up")[0].returncode == 0
+    result, calls = run(project, "shell", "true")
+    assert result.returncode == 0, result.stderr
+    assert runs(calls) == []
+    (exec_call,) = [call for call in calls if call[:1] == ["exec"]]
+    assert exec_call[-5:] == [persist_name(root), driver_path(), "--inside", "shell", "true"]
+    assert exec_call[exec_call.index("-w") + 1] == "/work/scratch"
+
+
+def test_a_container_of_another_tag_falls_back_and_says_so(project):
+    root, _, bin_dir = project
+    (bin_dir.parent / "state").write_text(persist_name(root) + "\nold0000000000\n", encoding="utf-8")
+    result, calls = run(project, "shell", "true")
+    assert result.returncode == 0, result.stderr
+    assert runs(calls)
+    assert "kazarov up" in result.stderr
+
+
+def test_keep_persist_starts_the_container_then_execs(project):
+    result, calls = run(project, "shell", "true", env={"KZ_PERSIST": "1"})
+    assert result.returncode == 0, result.stderr
+    heads = [call[0] for call in calls]
+    assert heads.index("run") < heads.index("exec")
+    assert runs(calls)[0][:3] == ["run", "-d", "--name"]
+
+
+def test_down_removes_the_container_once(project):
+    assert run(project, "up")[0].returncode == 0
+    result, _ = run(project, "down")
+    assert result.returncode == 0, result.stderr
+    assert "removed" in result.stdout
+    again, _ = run(project, "down")
+    assert "no persistent container" in again.stdout
