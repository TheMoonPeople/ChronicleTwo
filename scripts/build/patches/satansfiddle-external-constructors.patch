+fn constructor_scope(process: &SBProcess, object: u32) -> Result<Option<String>> {
+    let mut scope = hooks::u32_at(process, object as u64 + 4)?;
+    let mut seen = HashSet::new();
+    let mut name = None;
+    while scope != 0 {
+        ensure!(seen.insert(scope) && seen.len() <= 32, "cyclic/deep constructor scope");
+        let identifier = hooks::u32_at(process, scope as u64 + 4)?;
+        if identifier != 0 {
+            if name.is_some() { return Ok(None); }
+            let text = hooks::cstring(process, identifier as u64 + 10)?;
+            if text.is_empty() { return Ok(None); }
+            for byte in text.bytes() {
+                if !byte.is_ascii_alphanumeric() && byte != b'_' { return Ok(None); }
+            }
+            name = Some(format!("__ct__{}{}F", text.len(), text));
+        }
+        scope = hooks::u32_at(process, scope as u64)?;
+    }
+    Ok(name)
+}
