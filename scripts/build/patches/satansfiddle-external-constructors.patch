+#[test]
+#[ignore = "requires SATANSFIDDLE_TEST_COMPILER_300 plus debug-symbol wibo"]
+fn real_placement_external_constructor_conversion() {
+    let compiler = PathBuf::from(env::var_os("SATANSFIDDLE_TEST_COMPILER_300").unwrap());
+    let work = Workspace::new();
+    let input = work.0.join("placement.cpp");
+    let config = work.0.join("config.json");
+    let output = work.0.join("selected.o");
+    let source = PLACEMENT_SOURCE
+        .replace("Thing() : value(7) {}", "Thing();")
+        .replace("Other() : value(11) {}", "Other();");
+    fs::write(&input, &source).unwrap();
+    let mut baseline_profile: serde_json::Value = serde_json::from_str(&compiler_config(&compiler, "")).unwrap();
+    let options = baseline_profile["compiler_options"].as_str().unwrap().to_owned();
+    baseline_profile["compiler_options"] = format!("{options} -lang c++").into();
+    fs::write(&config, serde_json::to_string(&baseline_profile).unwrap()).unwrap();
+    assert_success(&cli(&input, &output, &config));
+    let baseline = fs::read(&output).unwrap();
+    let profile = placement_config(&compiler, "selected__FPvi", "__ct__5ThingFv",
+        "after_constructor_walk", 1);
+    fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+    assert_success(&cli(&input, &output, &config));
+    let selected = fs::read(&output).unwrap();
+    assert_ne!(function_bytes(&baseline, "selected__FPvi"), function_bytes(&selected, "selected__FPvi"));
+    for function in ["unselected__FPvi", "mixed__FPvPvi", "duplicate__FPvPvi"] {
+        assert_eq!(function_bytes(&baseline, function), function_bytes(&selected, function));
+    }
+    assert_success(&cli(&input, &output, &config));
+    assert_eq!(selected, fs::read(&output).unwrap());
+    for (function, count) in [("mixed__FPvPvi", 1), ("duplicate__FPvPvi", 2)] {
+        let profile = placement_config(&compiler, function, "__ct__5ThingFv",
+            "after_constructor_walk", count);
+        fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+        let result = cli_command(&input, &output, &config).env("SATANSFIDDLE_VERIFY", "1").output().unwrap();
+        assert_success(&result);
+        assert!(String::from_utf8_lossy(&result.stderr).contains(&format!("expected={count} actual={count}")));
+        let changed = fs::read(&output).unwrap();
+        assert_eq!(function_bytes(&baseline, "unselected__FPvi"), function_bytes(&changed, "unselected__FPvi"));
+    }
+    for (function, constructor, timing, count) in [
+        ("selected__FPvi", "__ct__5ThingFv", "after_constructor_walk", 2),
+        ("duplicate__FPvPvi", "__ct__5ThingFv", "after_constructor_walk", 1),
+        ("selected__FPvi", "__ct__5OtherFv", "after_constructor_walk", 1),
+        ("selected__FPvi", "__ct__5ThingFv", "after_constructor_inline", 1),
+        ("selected__FPvi", "__ct__5ThingFv", "before_constructor_inline", 1),
+    ] {
+        let profile = placement_config(&compiler, function, constructor, timing, count);
+        fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+        fs::write(&output, b"original object sentinel").unwrap();
+        let result = cli(&input, &output, &config);
+        assert!(!result.status.success());
+        assert_eq!(fs::read(&output).unwrap(), b"original object sentinel");
+    }
+    let grouped = source.replace("extern void use(Thing *);", "extern void use(Thing *); extern int combine(Thing *, Thing *);")
+        + "\nvoid grouped(void *a, void *b) { combine(new(a) Thing, new(b) Thing); }\n";
+    fs::write(&input, grouped).unwrap();
+    let grouped_profile = placement_config(&compiler, "grouped__FPvPv", "__ct__5ThingFv",
+        "after_constructor_walk", 2);
+    fs::write(&config, serde_json::to_string(&grouped_profile).unwrap()).unwrap();
+    fs::write(&output, b"original object sentinel").unwrap();
+    let result = cli(&input, &output, &config);
+    assert!(!result.status.success());
+    assert!(String::from_utf8_lossy(&result.stderr).contains("multiple selected constructions"));
+    assert_eq!(fs::read(&output).unwrap(), b"original object sentinel");
+    let overloaded = source.replace("Thing();", "Thing(int);").replace("new(buffer) Thing", "new(buffer) Thing(7)")
+        .replace("new(first) Thing", "new(first) Thing(7)").replace("new(second) Thing", "new(second) Thing(7)");
+    fs::write(&input, overloaded).unwrap();
+    fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+    fs::write(&output, b"original object sentinel").unwrap();
+    let result = cli(&input, &output, &config);
+    assert!(!result.status.success());
+    assert!(String::from_utf8_lossy(&result.stderr).contains("ambiguous placement identity"));
+    assert_eq!(fs::read(&output).unwrap(), b"original object sentinel");
+    fs::write(&input, PLACEMENT_SOURCE).unwrap();
+    fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+    fs::write(&output, b"original object sentinel").unwrap();
+    let result = cli(&input, &output, &config);
+    assert!(!result.status.success());
+    assert!(String::from_utf8_lossy(&result.stderr).contains("matched 0"));
+    assert_eq!(fs::read(&output).unwrap(), b"original object sentinel");
+}
