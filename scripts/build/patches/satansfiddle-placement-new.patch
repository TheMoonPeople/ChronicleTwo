+        node(512, 0x38, &[]);
+        node(768, 0x32, &[]);
+        let read = |address: u64, size| Ok(bytes[address as usize..address as usize + size].to_vec());
+        assert_eq!(walk_constructions(64, read).unwrap(), HashSet::from([128,256]));
+        assert_eq!(walk_constructions(128, read).unwrap(), HashSet::from([128]));
+        bytes[64+0x1c..64+0x20].copy_from_slice(&128u32.to_le_bytes());
+        assert!(walk_constructions(64, |a,s| Ok(bytes[a as usize..a as usize+s].to_vec())).is_err());
+        bytes[64+0x1c..64+0x20].copy_from_slice(&256u32.to_le_bytes());
+        bytes[256] = 0x35;
+        assert!(walk_constructions(64, |a,s| Ok(bytes[a as usize..a as usize+s].to_vec())).is_err());
+        bytes[256] = 0x3a;
+        bytes[128+0x18..128+0x1c].copy_from_slice(&64u32.to_le_bytes());
+        assert!(walk_constructions(64, |a,s| Ok(bytes[a as usize..a as usize+s].to_vec())).is_err());
