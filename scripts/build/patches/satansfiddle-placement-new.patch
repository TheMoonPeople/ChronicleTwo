+        let mut bytes = vec![0u8; 2048];
+        let mut node = |address: usize, kind: u8, children: &[(usize, u32)]| {
+            bytes[address] = kind;
+            for &(offset, child) in children {
+                bytes[address + offset..address + offset + 4].copy_from_slice(&child.to_le_bytes());
+            }
+        };
+        // Both paths share the unary ancestor, rather than the construction itself.
+        node(64, 0x29, &[(0x18, 128), (0x1c, 128)]);
+        node(128, 0x00, &[(0x18, 256)]);
+        node(256, 0x3a, &[(0x18, 512), (0x1c, 768)]);
+        node(512, 0x38, &[]);
+        node(768, 0x32, &[]);
+        let error = walk_constructions(64,
+            |address, size| Ok(bytes[address as usize..address as usize + size].to_vec()))
+            .unwrap_err();
+        assert!(error.to_string().contains("shared construction-bearing placement expression subtree"));
+
+        // Sharing the same composite subtree is safe once it contains only a leaf.
+        bytes[256] = 0x32;
+        assert!(walk_constructions(64,
+            |address, size| Ok(bytes[address as usize..address as usize + size].to_vec()))
+            .unwrap().is_empty());
+    }
