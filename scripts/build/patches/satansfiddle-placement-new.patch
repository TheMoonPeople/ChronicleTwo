+//! A transactional, identity-checked request for MWCC's ordinary scalar-new
+//! statement conversion. No constructor metadata or generated code is patched.
+use crate::{compiler::Compiler, config::{self, PlacementConversion}, hooks};
+use anyhow::{Result, anyhow, bail, ensure};
+use lldb::{SBFrame, SBProcess};
+use std::collections::{HashMap, HashSet};
+
+const NEW_ENTER: u64 = 0x46380e;
+const NEW_RETURN: u64 = 0x46383b;
+const INLINE_READ: u64 = 0x462fa3;
+const STATEMENT_ENTER: u64 = 0x464b80;
+const STATEMENT_RETURN: u64 = 0x464b8d;
+const CONVERSION_ENTER: u64 = 0x464bae;
+const CONVERSION_RETURN: u64 = 0x464bb4;
+const CONVERT_NEW: u64 = 0x463dec;
+const MANGLED_NAME: u64 = 0x450294;
+const AST_ARENA_RESET: u64 = 0x43300a;
+const ARENA_TEARDOWN: u64 = 0x432e80;
+const FRONTEND_FUNCTION: u64 = 0x54d6d2;
+const CONVERSION_REQUEST: u64 = 0x54d6f8;
+
+pub fn configure(process: &SBProcess, compiler: &Compiler) -> Result<Vec<u64>> {
+    if config::placement_new().statement_conversions.is_empty() {
+        return Ok(Vec::new());
+    }
+    ensure!(compiler.version == "3.0-011126",
+        "compiler {} has no verified placement-new frontend hooks", compiler.version);
+    let signatures: &[(u64, &[u8])] = &[
+        (NEW_ENTER, &[0x8b,0x46,0x18,0x50]),
+        (NEW_RETURN, &[0xe9,0x91,0,0,0]),
+        (INLINE_READ, &[0x3c,0x06,0x73,0x3d,0x3c,0x03]),
+        (STATEMENT_ENTER, &[0x8b,0x43,0x0a,0x50,0xe8,0x97,0xeb,0xff,0xff]),
+        (STATEMENT_RETURN, &[0x80,0x3d,0xf8,0xd6,0x54,0,0,0x74,0x2b]),
+        (CONVERSION_ENTER, &[0xe8,0x3d,0xf3,0xff,0xff]),
+        (CONVERSION_RETURN, &[0x8b,0x43,0x0a,0x50,0xe8,0x63,0xeb,0xff,0xff]),
+        (CONVERT_NEW, &[0xe8,0xff,0xfd,0xff,0xff]),
+        (MANGLED_NAME, &[0x5b,0xc3,0x83,0x7b,0x38,0,0x75,0x0a]),
+        (AST_ARENA_RESET, &[0x89,0x0d,0x9e,0xcb,0x54,0]),
+        (ARENA_TEARDOWN, &[0x68,0xa6,0xcb,0x54,0]),
+    ];
+    for &(address, signature) in signatures {
+        ensure!(hooks::read(process, address, signature.len())? == signature,
+            "placement-new opcode signature differs at {address:#x}");
+    }
+    Ok(signatures.iter().map(|&(address, _)| address).collect())
+}
+
+type Key = (u64, u32, u32);
+
+struct Record {
+    row: usize,
+    statement: u32,
+    objects: [u32; 3],
+    constructor_call: u32,
+    inline_seen: bool,
+    applied: bool,
+    converted: bool,
+}
+
+struct NewFrame {
+    sp: u64,
+    key: Option<Key>,
+}
+
+struct StatementScope {
+    sp: u64,
+    statement: u32,
+    constructions: HashSet<u32>,
+    selected: Option<Key>,
+}
+
+struct ConversionScope {
+    sp: u64,
+    key: Key,
+    entered: bool,
+    constructions: HashSet<u32>,
+    construction_visits: usize,
+}
+
+#[derive(Default)]
+pub struct State {
+    unit: String,
+    epoch: u64,
+    active: bool,
+    names: HashMap<u32, String>,
+    records: HashMap<Key, Record>,
+    matches: HashMap<usize, HashSet<Key>>,
+    new_frames: Vec<NewFrame>,
+    statements: Vec<StatementScope>,
+    conversions: Vec<ConversionScope>,
+}
+
+/// Alias traversal mirrors the measured kind-6 branch of MWCC's name reader.
+fn canonical(process: &SBProcess, mut object: u32) -> Result<Option<u32>> {
+    let mut seen = HashSet::new();
+    while object != 0 {
+        ensure!(seen.insert(object) && seen.len() <= 16, "cyclic/deep placement function alias");
+        match hooks::read(process, object as u64 + 2, 1)?[0] {
+            6 => object = hooks::u32_at(process, object as u64 + 0x28)?,
+            3 | 4 => return Ok(Some(object)),
+            _ => return Ok(None),
+        }
+    }
+    Ok(None)
+}
+
+fn direct_call(process: &SBProcess, node: u32) -> Result<Option<u32>> {
+    if node == 0 || hooks::read(process, node as u64, 1)?[0] != 0x36 {
+        return Ok(None);
+    }
+    let target = hooks::u32_at(process, node as u64 + 0x18)?;
+    if target == 0 || hooks::read(process, target as u64, 1)?[0] != 0x38 {
+        return Ok(None);
+    }
+    canonical(process, hooks::u32_at(process, target as u64 + 0x18)?)
+}
+
+fn raw_stem(mangled: &str) -> &str {
+    let start = if mangled.starts_with("__") { 2 } else { 0 };
+    mangled[start..].find("__").map_or(mangled, |end| &mangled[..start + end])
+}
+
+impl State {
+    pub fn begin_unit(&mut self, unit: &str) -> Result<()> {
+        self.check_live_complete()?;
+        self.unit = unit.to_owned();
+        self.epoch += 1;
+        self.active = config::placement_new().statement_conversions.iter()
+            .any(|row| row.translation_unit == unit);
+        self.names.clear();
+        self.records.clear();
+        Ok(())
+    }
+
+    fn name(&mut self, process: &SBProcess, object: u32) -> Result<(String, bool)> {
+        if let Some(name) = self.names.get(&object) {
+            return Ok((name.clone(), true));
+        }
+        let link = hooks::u32_at(process, object as u64 + 0x30)?;
+        if link != 0 {
+            let name = hooks::cstring(process, link as u64 + 10)?;
+            self.names.insert(object, name.clone());
+            return Ok((name, true));
+        }
+        let raw = hooks::u32_at(process, object as u64 + 8)?;
+        ensure!(raw != 0, "placement function has no identifier");
+        Ok((hooks::cstring(process, raw as u64 + 10)?, false))
+    }
+
+    fn validate_witnesses(&self) -> Result<()> {
+        for record in self.records.values() {
+            let row = &config::placement_new().statement_conversions[record.row];
+            for (&object, expected) in record.objects.iter()
+                .zip([&row.function, &row.allocator, &row.constructor]) {
+                if let Some(actual) = self.names.get(&object) {
+                    ensure!(actual == expected,
+                        "ambiguous placement identity: expected {expected}, witnessed {actual}");
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn check_live_complete(&self) -> Result<()> {
+        ensure!(self.new_frames.is_empty() && self.statements.is_empty()
+            && self.conversions.is_empty(), "placement frontend walk did not complete");
+        self.validate_witnesses()?;
+        for record in self.records.values() {
+            ensure!(record.applied && record.converted && record.inline_seen,
+                "selected placement construction did not complete its conversion");
+            ensure!(record.objects.iter().all(|object| self.names.contains_key(object)),
+                "selected placement construction has unresolved mangled identities");
+        }
+        Ok(())
+    }
+
+    pub fn check_complete(&self, units: &HashSet<String>) -> Result<()> {
+        self.check_live_complete()?;
+        for (index, row) in config::placement_new().statement_conversions.iter().enumerate() {
+            if units.contains(&row.translation_unit) {
+                let actual = self.matches.get(&index).map_or(0, HashSet::len);
+                ensure!(actual == row.expected_matches,
+                    "placement expected {} distinct constructions, matched {actual} in {}/{} / {}",
+                    row.expected_matches, row.translation_unit, row.function, row.constructor);
+                if std::env::var_os("SATANSFIDDLE_VERIFY").is_some() {
+                    eprintln!("satansfiddle: placement {}/{} allocator={} constructor={} conversion={:?} expected={} actual={actual}",
+                        row.translation_unit, row.function, row.allocator, row.constructor,
+                        row.conversion, row.expected_matches);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    pub fn apply(&mut self, process: &SBProcess, frame: &SBFrame, pc: u64) -> Result<bool> {
+        if !self.active { return Ok(false); }
+        if pc == AST_ARENA_RESET || pc == ARENA_TEARDOWN {
+            self.check_live_complete()?;
+            self.epoch += 1;
+            self.records.clear();
+            self.names.clear();
+        } else if pc == MANGLED_NAME {
+            let object = hooks::reg(frame, "ebx")?;
+            ensure!(canonical(process, object)? == Some(object),
+                "placement mangled-name observer saw unsupported object");
+            let name = hooks::u32_at(process, object as u64 + 0x30)?;
+            ensure!(name != 0 && name == hooks::reg(frame, "eax")?,
+                "placement mangled-name observer lacks the normal cached result");
+            let text = hooks::cstring(process, name as u64 + 10)?;
+            if let Some(old) = self.names.insert(object, text.clone()) {
+                ensure!(old == text, "placement function object changed its mangled identity");
+            }
+            self.validate_witnesses()?;
+        } else if pc == STATEMENT_ENTER {
+            self.statements.push(StatementScope {
+                sp: frame.sp(), statement: hooks::reg(frame, "ebx")?,
+                constructions: HashSet::new(), selected: None,
+            });
+        } else if pc == NEW_ENTER {
+            let node = hooks::reg(frame, "esi")?;
+            ensure!(hooks::read(process, node as u64, 1)?[0] == 0x3a,
+                "placement hook expected scalar construction");
+            if let Some(scope) = self.statements.last_mut() {
+                scope.constructions.insert(node);
+            }
+            let mut key = None;
+            let constructor_call = hooks::u32_at(process, node as u64 + 0x1c)?;
+            if let (Some(caller), Some(allocator), Some(constructor)) = (
+                canonical(process, hooks::u32_at(process, FRONTEND_FUNCTION)?)?,
+                direct_call(process, hooks::u32_at(process, node as u64 + 0x18)?)?,
+                direct_call(process, constructor_call)?,
+            ) {
+                // Class 6 is a policy eligibility condition, independent of
+                // when MWCC publishes the constructor's mangled identity.
+                let info = hooks::u32_at(process, constructor as u64 + 0x28)?;
+                let class = if info == 0 { 0 } else {
+                    hooks::read(process, info as u64 + 0x64, 1)?[0]
+                };
+                if class == 6 {
+                    let objects = [caller, allocator, constructor];
+                    let names = objects.iter().map(|&object| self.name(process, object))
+                        .collect::<Result<Vec<_>>>()?;
+                    let candidates = config::placement_new().statement_conversions.iter().enumerate()
+                        .filter(|(_, row)| row.translation_unit == self.unit)
+                        .filter(|(_, row)| names.iter().zip([&row.function,&row.allocator,&row.constructor])
+                            .all(|((name, exact), wanted)| if *exact { name == wanted }
+                                else { name == raw_stem(wanted) }))
+                        .map(|(index, _)| index).collect::<Vec<_>>();
+                    ensure!(candidates.len() <= 1,
+                        "placement raw identities cannot uniquely select a conversion row");
+                    if let Some(&index) = candidates.first() {
+                        ensure!(self.new_frames.is_empty(), "selected nested placement construction is unsupported");
+                        if config::placement_new().statement_conversions[index].conversion
+                            == PlacementConversion::BeforeConstructorInline {
+                            audit_inline_body(process, constructor)?;
+                        }
+                        let scope = self.statements.last_mut()
+                            .ok_or_else(|| anyhow!("selected placement is outside a verified statement region"))?;
+                        let id = (self.epoch, caller, node);
+                        ensure!(scope.selected.is_none() || scope.selected == Some(id),
+                            "multiple selected constructions in one statement are unsupported");
+                        scope.selected = Some(id);
+                        if let Some(record) = self.records.get(&id) {
+                            ensure!(record.row == index && record.objects == objects
+                                && record.constructor_call == constructor_call
+                                && record.statement == scope.statement,
+                                "placement construction identity was reused with different ownership");
+                        } else {
+                            self.records.insert(id, Record { row: index, statement: scope.statement,
+                                objects, constructor_call, inline_seen: false, applied: false, converted: false });
+                        }
+                        if std::env::var_os("SATANSFIDDLE_VERIFY").is_some() {
+                            eprintln!("satansfiddle: placement-candidate {}/{} constructor={} names={names:?}",
+                                self.unit, config::placement_new().statement_conversions[index].function,
+                                config::placement_new().statement_conversions[index].constructor);
+                        }
+                        key = Some(id);
+                    }
+                } else if std::env::var_os("SATANSFIDDLE_VERIFY").is_some() {
+                    eprintln!("satansfiddle: placement ignored ineligible constructor inline class {class}");
+                }
+            }
+            self.new_frames.push(NewFrame { sp: frame.sp(), key });
+        } else if pc == INLINE_READ {
+            if let Some(key) = self.new_frames.last().and_then(|frame| frame.key) {
+                let object = canonical(process, hooks::reg(frame, "ebp")?)?;
+                let record = self.records.get_mut(&key).ok_or_else(|| anyhow!("missing placement record"))?;
+                let call = hooks::reg(frame, "ebx")?;
+                if object == Some(record.objects[2]) && call == record.constructor_call {
+                    let info = hooks::u32_at(process, record.objects[2] as u64 + 0x28)?;
+                    ensure!(hooks::reg(frame, "ebp")? == record.objects[2]
+                        && info != 0 && hooks::reg(frame, "edi")? == info
+                        && hooks::read(process, info as u64 + 0x64, 1)?[0] == 6,
+                        "placement inline read does not use the audited constructor metadata");
+                    ensure!(hooks::reg(frame, "eax")? & 255 == 6,
+                        "selected direct placement constructor changed inline class");
+                    ensure!(direct_call(process, call)? == object,
+                        "placement inline read does not belong to the direct constructor");
+                    record.inline_seen = true;
+                    if config::placement_new().statement_conversions[record.row].conversion
+                        == PlacementConversion::BeforeConstructorInline {
+                        let value = (hooks::reg(frame, "eax")? & !255) | 3;
+                        hooks::register(frame, "eax")?.set_value(&value.to_string())
+                            .map_err(|e| anyhow!("request statement constructor inline: {e:?}"))?;
+                    }
+                } else if object == Some(record.objects[2])
+                    && std::env::var_os("SATANSFIDDLE_VERIFY").is_some() {
+                    eprintln!("satansfiddle: placement preserved another ordinary constructor inline call");
+                }
+            }
+        } else if pc == NEW_RETURN {
+            let construction = self.new_frames.pop().ok_or_else(|| anyhow!("missing placement walk frame"))?;
+            ensure!(construction.sp == frame.sp(), "placement construction frame mismatch");
+            if let Some(key) = construction.key {
+                let record = self.records.get_mut(&key).ok_or_else(|| anyhow!("missing placement record"))?;
+                ensure!(record.inline_seen, "selected placement direct constructor was not inlined");
+                if config::placement_new().statement_conversions[record.row].conversion
+                    == PlacementConversion::AfterConstructorInline {
+                    let address = CONVERSION_REQUEST;
+                    #[cfg(feature = "hook-test-faults")]
+                    let address = if std::env::var_os("SATANSFIDDLE_TEST_FAIL_PLACEMENT_WRITE").is_some()
+                        { 0 } else { address };
+                    hooks::write(process, address, &[1])?;
+                }
+                record.applied = true;
+                self.matches.entry(record.row).or_default().insert(key);
+            }
+        } else if pc == STATEMENT_RETURN {
+            let scope = self.statements.pop().ok_or_else(|| anyhow!("missing placement statement frame"))?;
+            ensure!(scope.sp == frame.sp() && scope.statement == hooks::reg(frame, "ebx")?,
+                "placement statement frame mismatch");
+            if let Some(key) = scope.selected {
+                ensure!(scope.constructions.len() == 1 && scope.constructions.contains(&key.2),
+                    "selected placement statement contains sibling/nested constructions");
+                let expression = hooks::u32_at(process, scope.statement as u64 + 0x0a)?;
+                let (constructions, calls) = walk_expression(expression, false,
+                    |address,size| hooks::read(process,address,size))?;
+                ensure!(constructions.len() == 1 && constructions.contains(&key.2),
+                    "placement final expression contains unselected/hidden constructions");
+                audit_calls(process, calls)?;
+                ensure!(hooks::read(process, CONVERSION_REQUEST, 1)?[0] != 0,
+                    "placement policy did not request ordinary statement conversion");
+                self.conversions.push(ConversionScope { sp: frame.sp(), key,
+                    entered: false, constructions: HashSet::new(), construction_visits: 0 });
+            }
+        } else if pc == CONVERSION_ENTER {
+            if let Some(scope) = self.conversions.last_mut() {
+                ensure!(!scope.entered && frame.sp() + 4 == scope.sp,
+                    "placement conversion entry frame mismatch");
+                scope.entered = true;
+            }
+        } else if pc == CONVERT_NEW {
+            if let Some(scope) = self.conversions.last_mut() {
+                ensure!(scope.entered, "placement conversion did not enter ordinary lowering");
+                let node = hooks::reg(frame, "ebx")?;
+                ensure!(node == scope.key.2,
+                    "placement policy would convert an unselected construction");
+                scope.construction_visits += 1;
+                ensure!(scope.construction_visits == 1,
+                    "placement policy would convert the selected construction more than once");
+                scope.constructions.insert(node);
+            }
+        } else if pc == CONVERSION_RETURN {
+            if let Some(scope) = self.conversions.last() {
+                if scope.sp == frame.sp() {
+                    let scope = self.conversions.pop().unwrap();
+                    ensure!(scope.entered && scope.constructions.len() == 1
+                        && scope.construction_visits == 1
+                        && scope.constructions.contains(&scope.key.2),
+                        "placement conversion did not lower exactly the selected construction");
+                    self.records.get_mut(&scope.key).ok_or_else(|| anyhow!("missing placement record"))?
+                        .converted = true;
+                }
+            }
+        } else { return Ok(false); }
+        Ok(true)
+    }
+}
