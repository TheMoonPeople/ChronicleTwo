+/// A copied expression may retain an inline helper call for a later walk.
+/// Audit that body's graph before allowing the enclosing conversion to run.
+fn audit_calls(process: &SBProcess, targets: HashSet<u32>) -> Result<()> {
+    for target in targets {
+        ensure!(target != 0 && hooks::read(process,target as u64,1)?[0] == 0x38,
+            "placement final expression has an unsupported indirect call");
+        let object = canonical(process,hooks::u32_at(process,target as u64 + 0x18)?)?
+            .ok_or_else(|| anyhow!("placement final expression has an unsupported call target"))?;
+        audit_inline_body(process, object)?;
+    }
+    Ok(())
+}
+
+/// Conversion can defer copying constructor or helper bodies. Audit their
+/// retained expression bodies and every available inline callee first, so a
+/// later inline pass cannot expose an unselected scalar construction.
+fn audit_inline_body(process: &SBProcess, constructor: u32) -> Result<()> {
+    let mut pending = vec![constructor];
+    let mut done = HashSet::new();
+    while let Some(object) = pending.pop() {
+        if !done.insert(object) { continue; }
+        ensure!(done.len() <= 256, "placement inline-body graph exceeds verified limit");
+        let info = hooks::u32_at(process, object as u64 + 0x28)?;
+        if info == 0 || hooks::read(process, info as u64 + 0x64, 1)?[0] == 0 { continue; }
+        let count = i16::from_le_bytes(hooks::read(process, info as u64 + 0x0c, 2)?
+            .try_into().map_err(|_| anyhow!("invalid placement inline body count"))?);
+        ensure!((0..=1024).contains(&count), "unsupported placement inline body extent");
+        let body = hooks::u32_at(process, info as u64 + 0x0e)?;
+        ensure!(count == 0 || body != 0, "missing placement inline body");
+        for index in 0..count as u64 {
+            let statement = body as u64 + index * 24;
+            ensure!(hooks::u32_at(process, statement + 0x0c)? == 0,
+                "placement has unsupported inline-body cleanup metadata");
+            ensure!(matches!(hooks::read(process, statement, 1)?[0], 4 | 8),
+                "placement has a non-expression inline callee body");
+            let expression = hooks::u32_at(process, statement + 0x10)?;
+            if hooks::read(process, statement, 1)?[0] == 8 && expression == 0 {
+                let function_type = hooks::u32_at(process, object as u64 + 0x0c)?;
+                ensure!(function_type != 0
+                    && hooks::u32_at(process, function_type as u64 + 0x0e)? == 0x531f90,
+                    "placement inline body has an empty non-void return record");
+            }
+            let (news, calls) = walk_expression(expression, true,
+                |address, size| hooks::read(process, address, size))?;
+            ensure!(news.is_empty(), "placement has a latent nested construction");
+            for target in calls {
+                ensure!(target != 0 && hooks::read(process, target as u64, 1)?[0] == 0x38,
+                    "placement has an unsupported indirect inline-body call");
+                let callee = canonical(process, hooks::u32_at(process, target as u64 + 0x18)?)?
+                    .ok_or_else(|| anyhow!("placement has an unsupported inline-body callee"))?;
+                pending.push(callee);
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Walk the measured expression grammars without hiding shared constructions.
+#[cfg(test)]
+fn walk_constructions<F>(root: u32, mut read: F) -> Result<HashSet<u32>>
+where F: FnMut(u64, usize) -> Result<Vec<u8>> {
+    Ok(walk_expression(root, false, &mut read)?.0)
+}
+
+fn walk_expression<F>(root: u32, inline_template: bool, mut read: F) -> Result<(HashSet<u32>, HashSet<u32>)>
+where F: FnMut(u64, usize) -> Result<Vec<u8>> {
+    fn word<F>(read: &mut F, address: u64) -> Result<u32>
+    where F: FnMut(u64, usize) -> Result<Vec<u8>> {
+        Ok(u32::from_le_bytes(read(address, 4)?.try_into()
+            .map_err(|_| anyhow!("invalid placement AST word"))?))
+    }
+    let mut pending = vec![(root, false)];
+    let mut active = HashSet::new();
+    let mut done = HashSet::new();
+    let mut children: HashMap<u32, Vec<u32>> = HashMap::new();
+    let mut contains_construction = HashMap::new();
+    let mut result = HashSet::new();
+    let mut calls = HashSet::new();
+    while let Some((node, returning)) = pending.pop() {
+        if node == 0 { continue; }
+        if returning {
+            let contains = result.contains(&node) || children.get(&node).into_iter().flatten()
+                .any(|child| contains_construction.get(child).copied().unwrap_or(false));
+            contains_construction.insert(node, contains);
+            active.remove(&node); done.insert(node); continue;
+        }
+        if done.contains(&node) {
+            ensure!(!contains_construction.get(&node).copied().unwrap_or(false),
+                "shared construction-bearing placement expression subtree");
+            continue;
+        }
+        ensure!(active.insert(node), "cyclic placement final expression");
+        ensure!(done.len() + active.len() <= 4096, "placement final expression exceeds verified limit");
+        pending.push((node, true));
+        let address = node as u64;
+        let kind = read(address, 1)?[0];
+        let mut node_children = Vec::new();
+        let fields: &[u64] = match kind {
+            0x00..=0x08 | 0x30 | 0x31 => &[0x18],
+            0x09..=0x2f | 0x41 | 0x42 if inline_template => &[0x18, 0x1c],
+            0x09 | 0x0b | 0x0c | 0x0f..=0x2c | 0x39 => &[0x18, 0x1c],
+            0x3a => { result.insert(node); &[0x18, 0x1c] }
+            0x36 | 0x37 => {
+                calls.insert(word(&mut read, address + 0x18)?);
+                let mut argument = word(&mut read, address + 0x1c)?;
+                let mut seen = HashSet::new();
+                while argument != 0 {
+                    ensure!(seen.insert(argument) && seen.len() <= 256,
+                        "cyclic/deep placement expression argument list");
+                    let child = word(&mut read, argument as u64 + 4)?;
+                    node_children.push(child);
+                    pending.push((child, false));
+                    argument = word(&mut read, argument as u64)?;
+                }
+                &[0x18]
+            }
+            0x43 => &[0x18, 0x1c, 0x20, 0x24],
+            0x45 => {
+                let descriptor = word(&mut read, address + 0x18)?;
+                ensure!(descriptor != 0, "null placement expression descriptor");
+                let child = word(&mut read, descriptor as u64 + 4)?;
+                node_children.push(child);
+                pending.push((child, false));
+                &[]
+            }
+            0x3c..=0x3e if inline_template => &[],
+            0x32..=0x34 | 0x38 | 0x3b | 0x3f | 0x44 | 0x47 => &[],
+            _ => bail!("unsupported placement final-expression kind {kind:#x}"),
+        };
+        for &field in fields {
+            let child = word(&mut read, address + field)?;
+            node_children.push(child);
+            pending.push((child, false));
+        }
+        children.insert(node, node_children);
+    }
+    Ok((result, calls))
+}
