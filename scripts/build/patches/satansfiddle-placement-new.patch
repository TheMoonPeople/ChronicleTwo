+const PLACEMENT: &str = r#"
+[[placement_new.statement_conversions]]
+translation_unit = 'path\\test.cpp'
+function = 'probe__FPv'
+allocator = '__nw__FUiPv'
+constructor = '__ct__5ThingFv'
+conversion = 'after_constructor_inline'
+expected_matches = 1
+"#;
