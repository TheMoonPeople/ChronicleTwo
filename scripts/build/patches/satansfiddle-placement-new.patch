+#[test]
+fn placement_identity_and_cardinality_are_mandatory() {
+    let config = parse(PLACEMENT).unwrap();
+    assert_eq!(config.placement_new.statement_conversions[0].translation_unit, "test.cpp");
+    for field in ["function", "allocator", "constructor", "conversion", "expected_matches"] {
+        let invalid = PLACEMENT.lines().filter(|line| !line.starts_with(field))
+            .collect::<Vec<_>>().join("\n");
+        assert!(parse(&invalid).is_err(), "missing {field}");
+    }
+    assert!(parse(&PLACEMENT.replace("expected_matches = 1", "expected_matches = 0")).is_err());
+    assert!(parse(&PLACEMENT.replace("after_constructor_inline", "guess")).is_err());
+    assert!(parse(&PLACEMENT.replace("__ct__5ThingFv", "Thing")).is_err());
+    assert!(parse(&PLACEMENT.replace("__nw__FUiPv", "__nwa__FUiPv")).is_err());
+    assert!(parse(&format!("{PLACEMENT}\nordinal = 1")).is_err());
+    assert!(parse(&format!("{PLACEMENT}\n{PLACEMENT}")).is_err());
+    assert!(parse("").unwrap().placement_new.statement_conversions.is_empty());
