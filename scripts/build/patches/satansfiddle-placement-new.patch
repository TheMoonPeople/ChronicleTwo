+#[test]
+#[ignore = "requires SATANSFIDDLE_TEST_COMPILER_300 plus debug-symbol wibo"]
+fn real_placement_conversion_is_scoped_and_transactional() {
+    let compiler = PathBuf::from(env::var_os("SATANSFIDDLE_TEST_COMPILER_300").unwrap());
+    let work = Workspace::new();
+    let input = work.0.join("placement.cpp");
+    let config = work.0.join("config.json");
+    let baseline = work.0.join("baseline.o");
+    fs::write(&input, PLACEMENT_SOURCE).unwrap();
+    fs::write(&config, compiler_config(&compiler, "")).unwrap();
+    assert_success(&cli(&input, &baseline, &config));
+    let original = fs::read(&baseline).unwrap();
+    for timing in ["before_constructor_inline", "after_constructor_inline"] {
+        let profile = placement_config(&compiler, "selected__FPvi", "__ct__5ThingFv", timing, 1);
+        fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+        let output = work.0.join(format!("selected-{timing}.o"));
+        let result = cli_command(&input, &output, &config).env("SATANSFIDDLE_VERIFY", "1")
+            .output().unwrap();
+        assert_success(&result);
+        assert!(String::from_utf8_lossy(&result.stderr).contains("expected=1 actual=1"));
+        let selected = fs::read(&output).unwrap();
+        assert_ne!(function_bytes(&original, "selected__FPvi"),
+            function_bytes(&selected, "selected__FPvi"));
+        for function in ["unselected__FPvi", "mixed__FPvPvi", "duplicate__FPvPvi"] {
+            assert_eq!(function_bytes(&original, function), function_bytes(&selected, function),
+                "unselected function {function} changed under {timing}");
+        }
+        let repeat = work.0.join(format!("repeat-{timing}.o"));
+        assert_success(&cli(&input, &repeat, &config));
+        assert_eq!(selected, fs::read(&repeat).unwrap());
+    }
+
+    // A different eligible constructor in another statement of the same
+    // caller remains outside the selected identity and count.
+    for timing in ["before_constructor_inline", "after_constructor_inline"] {
+        let profile = placement_config(&compiler, "mixed__FPvPvi", "__ct__5ThingFv", timing, 1);
+        fs::write(&config,serde_json::to_string(&profile).unwrap()).unwrap();
+        let output = work.0.join(format!("mixed-{timing}.o"));
+        let result = cli_command(&input,&output,&config).env("SATANSFIDDLE_VERIFY","1")
+            .output().unwrap();
+        assert_success(&result);
+        assert!(String::from_utf8_lossy(&result.stderr).contains("expected=1 actual=1"));
+        let selected = fs::read(&output).unwrap();
+        assert_ne!(function_bytes(&original,"mixed__FPvPvi"),
+            function_bytes(&selected,"mixed__FPvPvi"));
+        for function in ["selected__FPvi","unselected__FPvi","duplicate__FPvPvi"] {
+            assert_eq!(function_bytes(&original,function),function_bytes(&selected,function));
+        }
+    }
+
+    // Two constructions with the same identities receive one policy. Count is
+    // a fail-closed assertion, never a site selector.
+    let mut profile = placement_config(&compiler, "duplicate__FPvPvi", "__ct__5ThingFv",
+        "after_constructor_inline", 2);
+    fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+    assert_success(&cli(&input, &work.0.join("duplicate.o"), &config));
+    profile["placement_new"]["statement_conversions"][0]["expected_matches"] = 1.into();
+    for existing in [false, true] {
+        let output = work.0.join(format!("rejected-{existing}.o"));
+        if existing { fs::write(&output, b"existing object sentinel").unwrap(); }
+        fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+        let result = cli(&input, &output, &config);
+        assert!(!result.status.success());
+        assert!(String::from_utf8_lossy(&result.stderr).contains("matched 2"));
+        if existing { assert_eq!(fs::read(&output).unwrap(), b"existing object sentinel"); }
+        else { assert!(!output.exists()); }
+    }
+
+    // Temporary physical input names retain the original logical TU identity.
+    let temporary = work.0.join("generated-pass.c");
+    fs::write(&temporary, PLACEMENT_SOURCE).unwrap();
+    let profile = placement_config(&compiler, "selected__FPvi", "__ct__5ThingFv",
+        "after_constructor_inline", 1);
+    fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+    let result = cli_command(&temporary, &work.0.join("temporary.o"), &config)
+        .args(["--translation-unit", "path\\placement.cpp"])
+        .output().unwrap();
+    assert_success(&result);
+    assert!(fs::read_dir(&work.0).unwrap().all(|entry| !entry.unwrap().file_name()
+        .to_string_lossy().starts_with(".satansfiddle-")));
+}
