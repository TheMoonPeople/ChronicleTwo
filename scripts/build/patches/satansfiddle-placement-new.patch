+fn placement_config(compiler: &Path, function: &str, constructor: &str,
+    conversion: &str, expected: usize) -> serde_json::Value {
+    let mut config: serde_json::Value = serde_json::from_str(&compiler_config(compiler, "")).unwrap();
+    let options = config["compiler_options"].as_str().unwrap().to_owned();
+    config["compiler_options"] = format!("{options} -lang c++").into();
+    config["placement_new"] = serde_json::json!({"statement_conversions": [{
+        "translation_unit": "placement.cpp", "function": function,
+        "allocator": "__nw__FUiPv", "constructor": constructor,
+        "conversion": conversion, "expected_matches": expected,
+    }]});
+    config
+}
+
+const PLACEMENT_SOURCE: &str = r#"
+void *operator new(unsigned int, void *);
+struct Thing { int value; Thing() : value(7) {} };
+struct Other { int value; Other() : value(11) {} };
+extern void use(Thing *);
+extern void use_other(Other *);
+int selected(void *buffer, int value) {
+    Thing *object = new(buffer) Thing;
+    use(object);
+    return object->value + value;
+}
+int unselected(void *buffer, int value) {
+    Thing *object = new(buffer) Thing;
+    use(object);
+    return object->value + value;
+}
+int mixed(void *buffer, void *other, int value) {
+    Thing *object = new(buffer) Thing;
+    Other *second = new(other) Other;
+    use(object); use_other(second);
+    return object->value + second->value + value;
+}
+int duplicate(void *first, void *second, int value) {
+    Thing *a = new(first) Thing;
+    Thing *b = new(second) Thing;
+    use(a); use(b);
+    return a->value + b->value + value;
+}
+"#;
