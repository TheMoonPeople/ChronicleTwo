+    let source = r#"void *operator new(unsigned int, void *);
+extern void consume(void *);
+extern void side_effect();
+struct Life { Life(); ~Life(); };
+inline int clean(int v) { Life local; consume(&local); return v; }
+struct Thing { int value; Thing() : value(clean(7)) {} };
+
+int selected(void *p, int value) {
+    Thing *object = new(p) Thing;
+    consume(object);
+    return object->value + value;
+}
+"#;
+    fs::write(&input, source).unwrap();
+    // The selected Thing constructor is class 6. Its direct clean(int) callee
+    // is class 3 with retained cleanup records, so eligibility is not the failure.
+    for timing in ["before_constructor_inline", "after_constructor_inline"] {
+        let profile = placement_config(&compiler, "selected__FPvi", "__ct__5ThingFv", timing, 1);
+        fs::write(&config, serde_json::to_string(&profile).unwrap()).unwrap();
+        let output = work.0.join(format!("cleanup-{timing}.o"));
+        fs::write(&output, b"original object sentinel").unwrap();
+        let result = cli_command(&input, &output, &config).env("SATANSFIDDLE_VERIFY", "1")
+            .output().unwrap();
