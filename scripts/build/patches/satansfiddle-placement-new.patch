+        assert!(!result.status.success(), "published cleanup-bearing inline body under {timing}");
+        assert!(trace.contains("placement has unsupported inline-body cleanup metadata"),
+            "fixture failed outside the retained-body metadata guard: {trace}");
+        assert_eq!(fs::read(&output).unwrap(), b"original object sentinel");
+        assert!(fs::read_dir(&work.0).unwrap().all(|entry| !entry.unwrap().file_name()
+            .to_string_lossy().starts_with(".satansfiddle-")));
+    }
