	event.load_map_sounds(1210)
	event.mark_camera_sequence_fade_track()
	event.fade_in_camera_sequence(10)
	camera.wait_until_done()
	event.set_message_window_mode(0, 4)
	event.set_message_draw_speed(0, 1)
	event.open_message_window_2(0, "[(!)]Busca al chico que se fue corriendo con tu\nentrada. Pregunta primero a los ciudadanos.")
	message.show_and_wait(0, -1, 8, 0, 0)
	event.set_message_window_mode(0, 7)
	event.set_message_draw_speed(0, 0)
	event.load_message_file(0, -1)
end

local script: { [any]: (...any) -> ...any } = {}

--- Does nothing at load time.
function script.setup() end

--- The event the town walk runs when the square button is pressed, after reloading the map script.
script.key_open = palm_brinks_m06.play_polcurse_speech_scene

--- Plays the Polcurse speech scene and jumps to map s42.
function script.cutscene_polcurse_speech()
	palm_brinks_m06.play_polcurse_speech_scene()
	event.jump_to_map_3(-1, "s42", 502)
end
script[151] = script.cutscene_polcurse_speech

--- Plays the hero run scene and returns to the circus map.
function script.cutscene_hero_run()
	palm_brinks_m06.load_opening_characters()
	palm_brinks_m06.play_hero_run_scene()
	event.set_active_camera_slot(0)
	event.set_previous_camera_slot(0)
	event.load_event_script("m06/m06.stb", -1)
end
script[152] = script.cutscene_hero_run

--- Plays the ticket theft cutscene and returns to the circus map.
function script.cutscene_ticket_theft()
	play_ticket_theft_scene()
	event.set_active_camera_slot(0)
	event.set_previous_camera_slot(0)
	event.load_event_script("m06/m06.stb", -1)
end
script[153] = script.cutscene_ticket_theft

--- Gives the ticket, plays the chase scene and returns to the circus map.
function script.cutscene_ticket_chase()
	event.add_inventory_item(353)
	palm_brinks_m06.play_ticket_chase_scene()
	event.set_active_camera_slot(0)
	event.set_previous_camera_slot(0)
	event.load_event_script("m06/m06.stb", -1)
end
script[154] = script.cutscene_ticket_chase

--- Plays the Halloween jump scene and jumps to map m08.
function script.cutscene_halloween_jump()
	palm_brinks_m06.play_halloween_jump_scene()
	event.set_active_camera_slot(0)
	event.set_previous_camera_slot(0)
	event.jump_to_map_3(-1, "m08", 152)
end
script[155] = script.cutscene_halloween_jump

return script
