		event.set_object_sequence_position(2, -4.82, -1000.0, 32.15)
		event.set_object_sequence_position(3, 11.42, -1000.0, 30.92)
		event.move_camera_sequence_eased(-1.25, 41.62, -332.44, -0.63, 27.02, -407.23, 120, 2, 1.0)
		camera.wait_until_done()
		event.fade_out_screen(30)
		wait.for_frame_count(30)
	end)
	event.cancel_drama_scene_skip()
	event.set_time_of_day(time_of_day)
