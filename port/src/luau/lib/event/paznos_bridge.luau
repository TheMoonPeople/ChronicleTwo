	event.set_object_handle_footstep_sound(0, 0)
	event.set_object_handle_footstep_sound(1, 0)
	event.delete_character_extension_packs(0)
	event.delete_character(32)
	event.delete_character(33)
	event.delete_character(34)
	event.delete_character(35)
	event.delete_character(36)
	event.delete_character(37)
	event.delete_character(38)
	event.delete_character(39)
	event.load_message_file(0, -1)
end

--- Computes a facing angle for the character, runs the talk state update and blends the character toward that angle.
function paznos_bridge.update_talk_character(character_id: s32, talk_mode: s32, option_a: s32, option_b: s32)
	local angle: f32 = 0
	local talk_option: s32 = 0
	angle = character.interpolate_path(character_id, option_a, option_b)
	paznos_bridge.update_talk_state(0, talk_mode, character_id, talk_option, 0)
	character.restore_facing_skipping(character_id, angle, option_a, option_b)
end

--- Updates the talk character's facing and plays the talk wait steps.
function paznos_bridge.update_talk_characters()
	local talk_option: s32 = 0
	local talk_character_id: s32 = 0
	local talk_character: s32 = 0
	local turn_character_id: s32 = 0
	local angle: f32 = 0
	print("talk_chara_id=", talk_character_id, "talk_chara=", talk_character, "\n")
	character.interpolate_between_points(talk_option, talk_character_id, 0)
	paznos_bridge.update_talk_state(0, -1, talk_character_id, talk_option, 0)
	paznos_bridge.update_talk_character(talk_character_id, -1, 0, 0)
	paznos_bridge.update_talk_state(0, -1, talk_character_id, talk_option, 0)
	character.turn_to_angle_skipping(turn_character_id, angle)
	paznos_bridge.update_talk_state(0, -1, talk_character_id, turn_character_id, 0)
	wait.pause_skippable(30)
	wait.pause_skippable(28)
	wait.pause_skippable(29)
end

--- Runs the talk state update steps for a character with the given mode and option.
function paznos_bridge.update_talk_state(slot: s32, talk_mode: s32, character_id: any, talk_option: s32, unused_value: any)
	local result: s32 = 0
	message.open_bubble_stub(slot, talk_mode, character_id, talk_option)
	do
		local _: any
		_, result = message.wait_answer_skipping(slot, 0, result)
	end
	message.close_skipping(slot)
end

return paznos_bridge
