--- Loads the p00_05a character into slot 8 when save flag 536 is set.
function paznos_bridge.load_flagged_extra_character()
	local story_flag: s32 = 0
	story_flag = event.get_save_flag(536) or story_flag
	event.get_save_flag(540)
	if story_flag == 1 then
		event.assign_memory_stack(4)
		event.clear_memory_stack(4)
		event.load_character(4, "chara/p00_05a.gltf", "info", 8)
		event.set_character_active(8)
		event.set_character_position(8, 0.0, 70.0, -80.0)
		event.set_character_rotation(8, 0.0, 0.0, 0.0)
		event.set_character_motion(8, "立ち", 4)
		event.set_scene_character_number(8, 400)
	end
end

--- Plays the wordless opening Paznos bridge scene of event 540 with Phorn and a shaking camera.
function paznos_bridge.play_event_540_scene_1()
	vm.section(function()
		event.set_save_flag(540, 1)
		event.initialize_event()
		event.set_message_window_mode(0, 7)
		event.assign_memory_stack(5)
		event.clear_memory_stack(5)
		event.get_playable_character()
		event.set_scene_status_flags(1, 0, 256, 1)
		event.change_directory("event/e500/e540/")
		event.load_message_file(0, 5, "e540_1.txt")
		event.set_character_active(0, 0)
		event.load_character(5, "e540_phorn.gltf", "info", 32)
		event.set_character_active(32)
		event.attach_object_handle_to_character(0, 32)
		event.clear_object_sequence(0)
		event.set_object_sequence_object(0, 0)
		event.change_directory("")
		event.attach_object_handle_to_map_part_2(1, "p04_s30")
		event.set_object_handle_visible(1, 0)
		event.attach_object_handle_to_map_part_2(2, "p05_s30")
		event.set_object_handle_visible(2, 0)
		event.set_object_handle_position(0, 0.0, 70.1, -10.0)
		event.set_object_handle_rotation(0, 0.0, 0.0, 0.0)
		event.set_object_handle_motion(0, "立ち", 4)
		event.set_object_handle_texture_animation(0, 0)
		event.set_object_handle_texture_animation(0, 1, "目パチ")
		event.enable_drama_skip()
		event.clear_camera_sequence()
		event.set_camera_sequence_look_at(0.0, 173.0, -75.0)
		event.set_camera_sequence_angle_height_distance(-2.7, 0.0, 10.0)
		event.move_camera_sequence_angle_height_distance(2.7, 0.0, 10.0, 120)
		event.shake_camera_sequence(0.0, 0.5, 0.0, -1)
		event.fade_in_screen(10)
		wait.frames(120)
		event.fade_out_screen(0)
	end)
	event.cancel_drama_scene_skip()
	event.set_character_active(0)
	event.set_scene_status_flags(1, 0, 256, 0)
	event.delete_character(32)
	event.load_message_file(0, -1)
end

