--!strict
--- Cutscenes and character setup for the Balance Valley Station map.

local vm = require("@lib/vm")
local message = vm.module("@lib/event/message")
local object = vm.module("@lib/event/object")
local train = vm.module("@lib/event/train")
local wait = vm.module("@lib/event/wait")

local balance_valley_station = {}

--- Hides the station map part once its story flag is set.
function balance_valley_station.hide_station_map_part()
	local flag_372: s32 = 0
	flag_372 = event.get_save_flag(372) or flag_372
	if flag_372 == 1 then
		event.attach_object_handle_to_map_part_2(0, "p09_s04")
		event.set_object_handle_visible(0, 0)
	end
end

--- Loads the chapter-specific and common station characters, hides the finished map part and places the villagers.
function balance_valley_station.initialize_station_characters()
	local chapter: s32 = 0
	chapter = event.get_chapter() or chapter
	if chapter ~= 6 and chapter ~= 7 then
		train.switch_train_parts()
	else
		object.reset_train_car_parts()
	end
	train.hide_train02_parts()
	balance_valley_station.hide_station_map_part()
	balance_valley_station.load_villagers()
	balance_valley_station.place_villagers()
end

--- Loads the station villagers at their positions, choosing the first by chapter and the other two by a story flag.
function balance_valley_station.load_villagers()
	local chapter: s32 = 0
	local flag_500: s32 = 0
	event.assign_memory_stack(4)
	event.clear_memory_stack(4)
	chapter = event.get_chapter() or chapter
	if chapter ~= 6 and chapter ~= 7 then
		event.load_character(4, "chara/p01_03a.gltf", "info", 24)
		event.set_character_position(24, -123.0, 36.0, -68.0)
		event.set_character_rotation(24, 0.0, -1.57, 0.0)
		event.set_scene_character_number(24, 1)
		event.register_villager(24, 1)
	else
		event.load_character(4, "chara/p00_31a.gltf", "info", 24)
		event.set_character_position(24, -123.0, 36.0, -68.0)
		event.set_character_rotation(24, 0.0, -1.57, 0.0)
		event.set_scene_character_number(24, 301)
		event.register_villager(24, 301)
	end
	flag_500 = event.get_save_flag(500) or flag_500
	if flag_500 == 0 then
		event.load_character(4, "chara/p01_06a.gltf", "info", 25)
		event.set_character_position(25, -99.9, 36.0, 456.5)
		event.set_character_rotation(25, 0.0, -1.5, 0.0)
		event.set_scene_character_number(25, 2)
		event.register_villager(25, 2)
		event.load_character(4, "chara/p01_07a.gltf", "info", 26)
		event.set_character_position(26, -99.6, 36.0, 855.2)
		event.set_character_rotation(26, 0.0, -2.37, 0.0)
		event.set_scene_character_number(26, 13)
		event.register_villager(26, 13)
	end
end

--- Activates the three station villagers at their standing positions with their idle motion.
function balance_valley_station.place_villagers()
	event.set_character_active(24)
	event.set_character_position(24, -123.0, 36.0, -68.0)
	event.set_character_rotation(24, 0.0, -1.57, 0.0)
	event.set_character_motion(24, "立ち", 4)
	event.set_character_active(25)
	event.set_character_position(25, -99.9, 36.0, 456.5)
	event.set_character_rotation(25, 0.0, -1.5, 0.0)
	event.set_character_motion(25, "立ち", 4)
	event.set_character_active(26)
	event.set_character_position(26, -99.6, 36.0, 855.2)
	event.set_character_rotation(26, 0.0, -2.37, 0.0)
	event.set_character_motion(26, "立ち", 4)
end

