--- Asks whether to leave and either runs the player along a path out of the map with a fade-out or walks a few steps back into the map, returning whether the player left.
function balance_valley_station.walk_to_map_exit()
	local exit_choice: any = 0
	local x: f32 = 0
	local y: f32 = 0
	local z: f32 = 0
	local target_x: f32 = 0
	local target_y: f32 = 0
	local target_z: f32 = 0
	local i: s32 = 0
	local step: number = 0
	return vm.guard(function()
		event.initialize_event()
		event.set_character_motion(0, "立ち")
		step = 1
		exit_choice = message.ask_yes_no(5, 1)
		event.attach_object_handle_to_character(0, 0)
		event.set_object_handle_footstep_sound(0, 2)
		event.clear_object_sequence(0)
		event.set_object_sequence_object(0, 0)
		if exit_choice == 0 then
			event.set_camera_sequence_position(-1159.24, 92.09, 269.02)
			event.set_camera_sequence_look_at(-1327.31, 55.37, 161.26)
			event.set_object_sequence_position(0, -1386.18, 24.63, 115.22)
			event.set_object_sequence_motion(0, "走り", 4, -1.0, 1)
			event.clear_object_sequence_path(0)
			event.set_object_sequence_path_frames(0, 60)
			event.add_object_sequence_path_point(0, -1386.18, 29.63, 115.22)
			event.add_object_sequence_path_point(0, -1421.37, 37.04, 89.07)
			event.add_object_sequence_path_point(0, -1441.04, 44.13, 68.02)
			event.add_object_sequence_path_point(0, -1454.41, 52.15, 47.35)
			event.add_object_sequence_path_point(0, -1465.6, 61.13, 26.8)
			event.add_object_sequence_path_point(0, -1475.99, 68.270004, 2.68)
			event.add_object_sequence_path_point(0, -1483.7, 77.97, -24.81)
			event.start_object_sequence_path(0)
			step = 2
			wait.frames(30)
			event.fade_out_screen(30)
			step = 3
			wait.frames(30)
			return 1
		else
			do
				local out1, out2, out3 = event.get_character_position(0)
				x = out1 or x
				y = out2 or y
				z = out3 or z
			end
			target_x = vm.f32(vm.f32(vm.sin(vm.f32(1.44)) * 30.0) + x)
			target_y = 0.0
			target_z = vm.f32(vm.f32(vm.cos(vm.f32(1.44)) * 30.0) + z)
			event.move_object_sequence(0, target_x, target_y, target_z, 30, 1)
			event.turn_object_sequence_toward(0, target_x, target_y, target_z, 10)
			event.set_object_sequence_motion(0, "歩き")
			i = 0
			while i < 30 do
				do
					local out1, out2, out3 = event.get_character_position(0)
					x = out1 or x
					y = out2 or y
					z = out3 or z
				end
				y = vm.f32(y + 30.0)
				event.set_camera_look_at(x, y, z)
				i = i + 1
				step = 4
				vm.wait(4)
			end
		end
		event.set_object_handle_footstep_sound(0, 0)
		return 0
	end, function(received: { any })
		if step <= 3 then
			if step == 1 then
				exit_choice = received[1] :: number
			end
			if step <= 1 then
				wait.frames_skipping(30)
			end
			if step <= 2 then
				wait.frames_skipping(30)
			end
			return 1
		end
		if step <= 4 then
			return 0
		end
		return nil
	end)
end

return balance_valley_station
