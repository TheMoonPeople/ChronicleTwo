--- Adds fixed offsets to a door height and to two door leaf angles in local variables only.
function zelmite_mine_s54.offset_door_angles()
	local offset_y: f32 = 0
	local left_leaf_angle: f32 = 0
	local right_leaf_angle: f32 = 0
	offset_y = vm.f32(offset_y + 100.0)
	left_leaf_angle = vm.f32(left_leaf_angle - vm.f32(1.4))
	right_leaf_angle = vm.f32(right_leaf_angle + vm.f32(1.4))
end

--- Attaches the door34 map parts to object handles, positions them and shows the second door state.
function zelmite_mine_s54.place_door_parts()
	local door_x: f32 = 0
	local door_y: f32 = 0
	local door_z: f32 = 0
	local left_x: f32 = 0
	local left_angle_y: f32 = 0
	local left_z: f32 = 0
	local right_x: f32 = 0
	local right_angle_y: f32 = 0
	local right_z: f32 = 0
	event.attach_object_handle_to_map_part_3(29, "door34", "d07d05_3-m0")
	do
		local out1, out2, out3 = event.get_object_handle_rotation(29)
		door_x = out1 or door_x
		door_y = out2 or door_y
		door_z = out3 or door_z
	end
	door_y = vm.f32(door_y + 100.0)
	event.attach_object_handle_to_map_part_3(30, "door34", "d07d05_1-m0")
	do
		local out1, out2, out3 = event.get_object_handle_rotation(30)
		left_x = out1 or left_x
		left_angle_y = out2 or left_angle_y
		left_z = out3 or left_z
	end
	event.attach_object_handle_to_map_part_3(31, "door34", "d07d05_1-m1")
	do
		local out1, out2, out3 = event.get_object_handle_rotation(31)
		right_x = out1 or right_x
		right_angle_y = out2 or right_angle_y
		right_z = out3 or right_z
	end
	left_angle_y = vm.f32(left_angle_y - vm.f32(1.4))
	left_angle_y = event.wrap_angle(left_angle_y) or left_angle_y
	right_angle_y = vm.f32(right_angle_y + vm.f32(1.4))
	right_angle_y = event.wrap_angle(right_angle_y) or right_angle_y
	event.set_object_handle_position(29, door_x, door_y, door_z)
	event.set_object_handle_rotation(30, left_x, left_angle_y, left_z)
	event.set_object_handle_rotation(31, right_x, right_angle_y, right_z)
	event.attach_object_handle_to_map_part_3(29, "door34", "d07da05a-a")
	event.set_object_handle_visible(29, 0)
	event.attach_object_handle_to_map_part_3(29, "door34", "d07dv05a-c")
	event.set_object_handle_visible(29, 0)
	event.attach_object_handle_to_map_part_3(29, "door34", "d07da05b-a")
	event.set_object_handle_visible(29, 1)
	event.attach_object_handle_to_map_part_3(29, "door34", "d07dv05b-c")
	event.set_object_handle_visible(29, 1)
end

