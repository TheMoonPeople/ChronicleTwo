--!strict
--- Event helpers for the Field Town f03 Interior i04 scenes.

local vm = require("@lib/vm")
local camera = vm.module("@lib/event/camera")
local message = vm.module("@lib/event/message")
local object = vm.module("@lib/event/object")
local wait = vm.module("@lib/event/wait")

local field_town_f03_interior_i04 = {}

--- Hides both map parts of the interior.
function field_town_f03_interior_i04.hide_map_parts()
	field_town_f03_interior_i04.set_map_parts_visible(0, 0)
end

--- Plays event e464, in which the party walks in, reacts with surprise and talks.
function field_town_f03_interior_i04.play_event_464()
	local event_sound_file: s32 = 0
	local playable_character: s32 = 0
	vm.section(function()
		field_town_f03_interior_i04.set_map_parts_visible(0, 0)
		event.set_save_flag(464, 1)
		event.initialize_event()
		event.set_message_window_mode(0, 7)
		event.load_map_sounds(4517)
		event_sound_file = event.load_sound_effect_file_2(4517) or event_sound_file
		event.assign_memory_stack(5)
		event.clear_memory_stack(5)
		playable_character = event.get_playable_character() or playable_character
		event.set_scene_status_flags(1, 0, 256, 1)
		event.change_directory("event/e400/e464/")
		event.load_message_file(0, 5, "e464_1.txt")
		if playable_character == 0 then
			event.load_character_motion_pack(5, "e464_mints.gltf", "info", 0)
			event.set_character_active(0)
			event.attach_object_handle_to_character(0, 0)
			event.clear_object_sequence(0)
			event.set_object_sequence_object(0, 0)
		end
		if playable_character == 1 then
			event.load_character_motion_pack(5, "e464_monica.gltf", "info", 0)
			event.set_character_active(0)
			event.attach_object_handle_to_character(1, 0)
			event.clear_object_sequence(1)
			event.set_object_sequence_object(1, 1)
		end
		event.change_directory("")
		if playable_character == 1 then
			event.load_character(5, "chara/c01_base.gltf", "info", 32)
			event.load_equipment_model(5, 0, 4, "info", 32)
			event.load_equipment_model(5, 0, 3, "info", 32)
			event.load_equipment_model(5, 0, 2, "info", 32, 33)
			event.load_character_motion_pack(5, "event/e400/e464/e464_mints.gltf", "info", 32)
			event.load_character_motion_pack(5, "event/basic_evmot/mints_set.gltf", "info", 32)
			event.attach_object_handle_to_character(0, 32)
			event.clear_object_sequence(0)
			event.set_object_sequence_object(0, 0)
			event.load_character_motion_pack(5, "event/basic_evmot/monica_set.gltf", "info", 0)
		else
			event.load_character(5, "chara/c02_base.gltf", "info", 32)
			event.load_equipment_model(5, 1, 4, "info", 32)
			event.load_equipment_model(5, 1, 3, "info", 32)
			event.load_equipment_model(5, 1, 2, "info", 32, 33)
			event.load_character_motion_pack(5, "event/e400/e464/e464_monica.gltf", "info", 32)
			event.load_character_motion_pack(5, "event/basic_evmot/monica_set.gltf", "info", 32)
			event.attach_object_handle_to_character(1, 32)
			event.clear_object_sequence(1)
			event.set_object_sequence_object(1, 1)
			event.load_character_motion_pack(5, "event/basic_evmot/mints_set.gltf", "info", 0)
		end
		event.set_character_active(32)
		event.set_character_active(33)
		event.set_object_handle_position(0, -10.0, 311.3, 900.0)
		event.set_object_handle_rotation(0, 0.0, 3.14, 0.0)
		event.set_object_handle_footstep_sound(0, 6)
		event.set_object_handle_position(1, 10.0, 311.3, 930.0)
		event.set_object_handle_rotation(1, 0.0, 3.14, 0.0)
		event.set_object_handle_footstep_sound(1, 6)
		event.enable_drama_skip()
		event.set_object_sequence_motion(0, "歩き", 4)
		event.delay_object_sequence_motion_track(0, 60)
		event.set_object_sequence_motion(0, "立ち")
		event.move_object_sequence(0, -10.0, 311.3, 860.0, 60)
		event.set_object_handle_texture_animation(0, 0)
		event.set_object_handle_texture_animation(0, 1, "デフォルト顔")
		event.set_object_handle_texture_animation(0, 1, "通常目パチ")
		event.set_object_handle_texture_animation(0, 1, "半口")
		event.set_object_sequence_motion(1, "歩き", 4)
		event.delay_object_sequence_motion_track(1, 70)
		event.set_object_sequence_motion(1, "立ち")
		event.move_object_sequence(1, 10.0, 311.3, 880.0, 70)
		event.set_object_handle_texture_animation(1, 0)
		event.set_object_handle_texture_animation(1, 1, "デフォルト顔")
		event.set_object_handle_texture_animation(1, 1, "通常目パチ")
		event.set_object_handle_texture_animation(1, 1, "半口")
		event.clear_camera_sequence()
		event.set_camera_sequence_position(60.07, 478.33, 724.73)
		event.set_camera_sequence_look_at(-18.43, 284.78, 945.51)
		event.move_camera_sequence_eased(269.43, 854.64, 236.34, -18.43, 284.78, 945.51, 60, 0, 1.0)
		event.fade_in_screen(30)
		camera.wait_until_done()
		wait.frames(10)
		event.set_camera_sequence_position(31.95, 382.24, 856.16)
		event.set_camera_sequence_look_at(-60.53, 354.53, 697.76)
		event.move_camera_sequence_eased(31.95, 382.24, 856.16, 88.2, 354.53, 699.39, 60, 0, 1.0)
		camera.wait_until_done()
		wait.frames(10)
		event.set_camera_sequence_position(-17.13, 313.76, 810.95)
		event.set_camera_sequence_look_at(-0.61, 327.72, 860.29)
		event.set_object_handle_texture_animation(0, 0)
		event.set_object_handle_texture_animation(0, 1, "デフォルト顔")
		event.set_object_handle_texture_animation(0, 1, "通常目パチ")
		event.set_object_handle_texture_animation(1, 0)
		event.set_object_handle_texture_animation(1, 1, "デフォルト顔")
		event.set_object_handle_texture_animation(1, 1, "通常目パチ")
		event.set_object_sequence_motion(0, "すごい！", 6)
		event.queue_object_sequence_next_motion(0, "すごい！L", 4)
		event.delay_object_sequence_sound_track(0, 10)
		event.play_object_sequence_sound(0, event_sound_file, 0)
		event.set_mouth_texture_animations(0, "わらい口パク")
		message.show_voiced(4640010)
		object.wait_until_done(0)
		event.set_object_sequence_motion(1, "歩き")
		event.delay_object_sequence_motion_track(1, 30)
		event.set_object_sequence_motion(1, "立ち")
		event.move_object_sequence(1, 10.0, 311.3, 860.0, 30)
		event.set_mouth_texture_animations(1, "わらい口パク")
		message.show_voiced(4640020)
		event.set_mouth_texture_animations(1, "わらい口パク")
		message.show_voiced(4640030)
		event.set_object_sequence_motion(0, "すごい！戻り", 6)
		event.queue_object_sequence_next_motion(0, "右向くL", 4)
		event.set_mouth_texture_animations(0, "わらい口パク")
		message.show_voiced(4640040)
		object.wait_until_done(0)
		event.set_object_sequence_motion(1, "左向く", 6)
		event.queue_object_sequence_next_motion(1, "左向くL", 4)
		event.set_mouth_texture_animations(1, "わらい口パク")
		message.show_voiced(4640050)
		object.wait_until_done(1)
		event.fade_out_screen(30)
		wait.frames(30)
	end)
	vm.entry(14)
	event.cancel_drama_scene_skip()
	event.set_character_active(0)
	event.set_character_active(32)
	event.set_character_active(33)
	event.set_scene_status_flags(1, 0, 256, 0)
	event.set_object_handle_footstep_sound(0, 0)
	event.set_object_handle_footstep_sound(1, 0)
	event.delete_character_extension_packs(0)
	event.delete_character(32)
	event.delete_character(33)
	event.load_message_file(0, -1)
	event.clear_object_sequence(0)
	event.clear_object_sequence(1)
end

--- Attaches the two map parts to object handles and sets their visibility.
function field_town_f03_interior_i04.set_map_parts_visible(part_07_visible: s32, part_05_visible: s32)
	event.attach_object_handle_to_map_part_3(0, "p07_f03i04", "f03i04_07-m")
	event.set_object_handle_visible(0, part_07_visible)
	event.attach_object_handle_to_map_part_3(1, "p05_f03i04", "f03i04_05-m")
	event.set_object_handle_visible(1, part_05_visible)
end

return field_town_f03_interior_i04
