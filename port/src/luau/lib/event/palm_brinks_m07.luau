--- Plays a voice line with its message window and holds the window for a number of frames before closing it.
function palm_brinks_m07.play_voiced_message_with_hold(voice_id: s32, max_frames: s32, hold_frames: s32)
	event.open_voice_stream_wave(1, voice_id)
	sound.wait_voice_stream_ready(1)
	event.open_message_window_2(0, voice_id)
	message.open(0, -1, 5, 0, 0)
	event.play_voice_stream(1)
	message.wait_voice_for(0, max_frames)
	event.set_message_button_prompt(0, 0)
	wait.frames(hold_frames)
	message.close(0)
	event.set_message_button_prompt(0, 1)
end

