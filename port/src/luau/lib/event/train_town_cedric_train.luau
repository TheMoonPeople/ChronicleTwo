		train_town_cedric_train.play_sky_pan_scene(se_id)
		train_town_cedric_train.play_departure_briefing_scene(se_id)
		train_town_cedric_train.play_crew_response_scene(se_id)
		train_town_cedric_train.play_departure_shout_scene(se_id)
		train_town_cedric_train.play_crew_run_scene(se_id)
		train_town_cedric_train.play_train_lights_and_steam_scene(se_id)
		train_town_cedric_train.play_station_gate_opening_scene(se_id)
		train_town_cedric_train.play_train_start_scene(se_id)
		train_town_cedric_train.play_train_acceleration_scene(se_id)
		train_town_cedric_train.play_train_departure_scene(se_id)
		train_town_cedric_train.play_train_far_view_scene(se_id)
		event.set_map_piece_character_motion("p01_train01", "kikan-m0", "停止")
		train_town_cedric_train.play_final_remark_scene(se_id)
		event.fade_out_music(30)
		event.fade_out_screen(30)
		wait.frames(30)
	end)
	event.cancel_drama_scene_skip()
	event.stop_music(0)
	event.stop_music(1)
	event.set_map_piece_character_motion("p01_train01", "kikan-m0", "停止")
	event.stop_sound_effect(se_id, 6)
	event.stop_sound_effect(se_id, 9)
	event.stop_sound_effect(se_id, 10)
	event.set_character_active(1, 0)
	event.clear_effect_manager()
	event.delete_character(33)
	event.delete_character(34)
	event.delete_character(35)
	event.delete_character(36)
	event.delete_character(38)
	event.delete_character(39)
	event.delete_character(40)
	event.fade_in_screen(30)
end

--- Moves the train along the track with the camera watching from above.
function train_town_cedric_train.play_train_departure_scene(se_id: any)
	event.set_camera_sequence_position(-292.76, 173.19, -1582.23)
	event.set_camera_sequence_look_at(-228.24, 151.8, -1773.02)
	event.clear_object_sequence(10)
	event.set_object_sequence_object(10, 10)
	event.set_object_sequence_position(10, -120.0, 0.0, -1690.0)
	event.move_object_sequence(10, -120.0, 0.0, -3050.0, 90)
