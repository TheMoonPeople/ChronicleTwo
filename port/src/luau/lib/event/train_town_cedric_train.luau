--- Initializes the train house by chapter and hides the train once it has departed.
function train_town_cedric_train.initialize_train_house()
	local chapter: s32 = 0
	local train_departed_flag: s32 = 0
	local flag_202: s32 = 0
	event.initialize_event()
	event.set_save_flag(40, 1)
	chapter = event.get_chapter() or chapter
	if chapter ~= 6 and chapter ~= 7 then
		train.switch_train_parts()
	else
		object.reset_train_car_parts()
	end
	train.hide_train02_parts()
	train_departed_flag = event.get_save_flag(9) or train_departed_flag
	flag_202 = event.get_save_flag(202) or flag_202
	if train_departed_flag ~= 0 and flag_202 == 0 then
		event.attach_object_handle_to_map_part_2(0, "p01_train01")
		event.set_object_handle_visible(0, 0)
		character.set_active_by_number(2, 0)
	end
end

