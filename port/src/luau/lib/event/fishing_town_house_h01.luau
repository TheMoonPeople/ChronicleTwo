--- Waits the given number of frames; the sound bank argument is unused.
function fishing_town_house_h01.wait_for_frames(sound_bank: any, frame_count: s32)
	for i = 0, frame_count - 1 do
		vm.wait(1)
	end
end

--- Waits for the given number of frames and starts the music on frame 60.
function fishing_town_house_h01.wait_frames_starting_music(sound_bank: any, frame_count: s32)
	for i = 0, frame_count - 1 do
		vm.wait(1)
		if i == 60 then
			event.play_music(0)
		end
	end
end

return fishing_town_house_h01
