--!strict
--- Shared helpers for the Starbre and Need cutscenes in the Fishing Town house.

local vm = require("@lib/vm")
local camera = vm.module("@lib/event/camera")
local cutscene = vm.module("@lib/event/cutscene")
local message = vm.module("@lib/event/message")
local object = vm.module("@lib/event/object")
local wait = vm.module("@lib/event/wait")

local fishing_town_house_h01 = {}

--- Moves the camera slowly toward Need while he speaks.
function fishing_town_house_h01.play_camera_pull_in_shot(sound_bank: any)
	event.set_camera_sequence_position(-0.73, 30.22, -58.88)
	event.set_camera_sequence_look_at(0.18, 32.06, -95.16)
	event.set_character_position(34, 0.22, 5.19, -94.18)
	event.set_character_rotation(34, 0.0, 0.0, 0.0)
	event.move_camera_sequence_eased(-0.4, 30.22, -71.81, 0.18, 32.06, -95.16, 100, 0, 0.4)
	event.set_mouth_texture_animations(2, "通常口パク")
	message.show_voiced(1090080)
	event.reset_mouth_texture_animations()
	camera.wait_until_done()
end

--- Shows Starbre putting his hand on his hip and slamming the desk, with the slam sound played once the motion reaches the slam, under a temporarily changed event projection.
function fishing_town_house_h01.play_desk_slam_shot(sound_bank: s32)
	local projection: f32 = 0
	projection = event.get_event_projection() or projection
	event.set_event_projection(813.9)
	event.set_camera_sequence_position(-11.48, 40.92, -121.7)
	event.set_camera_sequence_look_at(-8.15, 36.49, -100.87)
	event.set_character_active(1, 33)
	event.set_object_sequence_position(1, -4.0, 5.43, -39.21)
	event.set_object_sequence_rotation(1, 0.0, -3.12, 0.0)
	event.set_character_active(1, 34)
	event.set_object_sequence_position(2, 0.22, 5.19, -94.18)
	event.set_object_sequence_rotation(2, 0.0, 0.0, 0.0)
	event.set_object_sequence_motion(2, "立ちあがるL", 4)
	event.set_object_sequence_motion(1, "腰に手", 6)
	event.queue_object_sequence_next_motion(1, "腰に手L")
	object.wait_until_done(1)
	event.set_mouth_texture_animations(1, "通常口パク")
	message.show_voiced(1090020)
	event.reset_mouth_texture_animations()
	event.set_object_sequence_motion(1, "机をたたく", 6)
	event.queue_object_sequence_next_motion(1, "机をたたくL")
	wait.until_motion_progress_counted(33, vm.f32(0.805), -1.0, 60)
	event.play_sound_effect(sound_bank, 6)
	event.set_mouth_texture_animations(1, "通常口パク")
	message.show_voiced(1090030)
	event.reset_mouth_texture_animations()
	object.wait_until_done(1)
	event.set_event_projection(projection)
end

--- Shows the house door opening with Starbre entering while the camera moves into the room.
function fishing_town_house_h01.play_door_opening_shot(sound_bank: s32)
	event.set_camera_sequence_position(-0.92, 28.84, -32.55)
	event.set_camera_sequence_look_at(-0.27, 28.03, 22.59)
	event.set_character_active(1, 33)
	event.set_object_sequence_position(1, -0.66, 0.0, 123.46)
	event.set_object_sequence_rotation(1, 0.0, -3.12, 0.0)
	event.set_character_active(1, 35)
	event.set_object_sequence_position(3, -0.66, 0.0, 123.46)
	event.set_object_sequence_rotation(3, 0.0, -3.14, 0.0)
	event.play_sound_effect(sound_bank, 3)
	event.set_object_sequence_motion(1, "ドア開け", 6)
	event.set_object_sequence_motion(3, "ドア開け", 6)
	event.wait_object_sequence_motion_end(1)
	event.wait_object_sequence_motion_end(3)
	event.delay_camera_sequence_position_track(60)
	event.set_camera_sequence_position(9.38, 26.8, 22.17)
	event.set_camera_sequence_look_at(10.04, 25.99, 77.32)
	fishing_town_house_h01.wait_frames_starting_music(sound_bank, 160)
	object.wait_until_done(1)
	object.wait_until_done(3)
	camera.wait_until_done()
end

--- Plays the first Starbre and Need house cutscene, from Starbre entering through the door to the closing fade, and restores the event projection afterwards.
function fishing_town_house_h01.play_e109a_cutscene()
	local projection: f32 = 0
	local sound_bank: s32 = 0
	vm.section(function()
		event.set_save_flag(109, 1)
		event.initialize_event()
		event.set_message_window_mode(0, 7)
		event.load_map_sounds(1240)
		sound_bank = event.load_sound_effect_file_2(1240) or sound_bank
		projection = event.get_event_projection() or projection
		event.stop_music(0)
		wait.frames(4)
		event.load_music(101)
		event.assign_memory_stack(5)
		event.clear_memory_stack(5)
		event.clear_camera_sequence()
		event.set_camera_position(0.0, 0.0, 0.0)
		event.set_camera_look_at(1.0, 0.0, 0.0)
		event.set_character_active(0, 0)
		event.load_character(5, "event/e100/e109/e109_starbre.gltf", "info", 33)
		event.set_character_active(1, 33)
		event.attach_object_handle_to_character(1, 33)
		event.clear_object_sequence(1)
		event.set_object_sequence_object(1, 1)
		event.set_object_sequence_position(1, -0.66, 0.09, 140.34)
		event.set_object_sequence_rotation(1, 0.0, -3.12, 0.0)
		event.set_character_texture_animation(33, 0, "通常口パク")
		event.set_object_handle_sound_bank(1, sound_bank)
		event.load_character(5, "event/e100/e109/e109_need.gltf", "info", 34)
		event.set_character_active(1, 34)
		event.attach_object_handle_to_character(2, 34)
		event.clear_object_sequence(2)
		event.set_object_sequence_object(2, 2)
		event.set_object_sequence_position(2, 0.0, 50.0, 0.0)
		event.set_object_sequence_rotation(2, 0.0, 0.0, 0.0)
		event.set_character_texture_animation(34, 0, "通常口パク")
		event.set_object_handle_sound_bank(2, sound_bank)
		event.load_character(5, "event/e100/e109/e109_door.gltf", "info", 35)
		event.set_character_active(1, 35)
		event.attach_object_handle_to_character(3, 35)
		event.clear_object_sequence(3)
		event.set_object_sequence_object(3, 3)
		event.set_object_sequence_position(3, -0.66, 0.0, 123.46)
		event.set_object_sequence_rotation(3, 0.0, -3.14, 0.0)
		event.set_object_sequence_motion(3, "待機", 4)
		object.wait_until_done(3)
		event.attach_object_handle_to_map_part_3(10, "p06_i03h01a", "i03h01a_06-m")
		event.clear_object_sequence(10)
		event.set_object_sequence_object(10, 10)
		event.set_object_sequence_position(10, -25.673, -42.2002, -83.6474)
		event.attach_object_handle_to_map_part_3(11, "p05_i03h01a", "i03h01a_05-m")
		event.clear_object_sequence(11)
		event.set_object_sequence_object(11, 11)
		event.set_object_sequence_position(11, -25.4763, -40.9848, -84.1156)
		event.attach_object_handle_to_map_part_3(12, "p05_i03h01a", "i03h01a_05-m2")
		event.clear_object_sequence(12)
		event.set_object_sequence_object(12, 12)
		event.set_object_sequence_position(12, -26.5572, -30.485, -63.0372)
		event.attach_object_handle_to_map_part_3(13, "p11_i03h01a", "i03h01a_11-m")
		event.set_object_handle_visible(13, 0)
		event.load_message_file(0, 5, "event/e100/e109/e109a_1.txt")
		event.stop_music(0)
		event.set_object_sequence_texture_animation(1, 0)
		event.set_object_sequence_texture_animation(1, 1, "デフォルト顔")
		event.set_object_sequence_texture_animation(1, 1, "通常目パチ")
		event.set_object_sequence_texture_animation(2, 0)
		event.set_object_sequence_texture_animation(2, 1, "こまり顔")
		event.set_object_sequence_texture_animation(2, 1, "こまり目パチ")
		event.enable_drama_skip()
		cutscene.skip_value_command(sound_bank)
		fishing_town_house_h01.play_need_sitting_shot(sound_bank)
		fishing_town_house_h01.play_door_opening_shot(sound_bank)
		cutscene.skip_value_command(sound_bank)
		fishing_town_house_h01.play_need_stands_up_shot(sound_bank)
		fishing_town_house_h01.play_starbre_walk_in_shot(sound_bank)
		fishing_town_house_h01.play_desk_slam_shot(sound_bank)
		fishing_town_house_h01.play_need_sigh_shot(sound_bank)
		fishing_town_house_h01.play_starbre_need_talk_shot(sound_bank)
		fishing_town_house_h01.play_camera_pull_in_shot(sound_bank)
		event.fade_out_music(30)
		event.fade_out_screen(30)
		wait.frames(30)
	end)
	event.cancel_drama_scene_skip()
	event.set_character_active(1, 0)
	event.set_event_projection(projection)
	event.delete_character(33)
	event.delete_character(34)
	event.delete_character(35)
	event.stop_music(0)
	event.fade_in_screen(30)
end

