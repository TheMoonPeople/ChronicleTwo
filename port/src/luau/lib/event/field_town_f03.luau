--!strict
--- Helpers for field town f03: analysis flag lookups and cutscenes.

local vm = require("@lib/vm")
local camera = vm.module("@lib/event/camera")
local character = vm.module("@lib/event/character")
local georama = vm.module("@lib/event/georama")
local message = vm.module("@lib/event/message")
local object = vm.module("@lib/event/object")
local wait = vm.module("@lib/event/wait")

local field_town_f03 = {}

--- Returns georama analysis flag 300.
function field_town_f03.get_analysis_flag_300()
	local flag_value: s32 = 0
	flag_value = event.get_georama_analysis_flag(300) or flag_value
	return flag_value
end

--- Returns georama analysis flag 303.
function field_town_f03.get_analysis_flag_303()
	local flag_value: s32 = 0
	flag_value = event.get_georama_analysis_flag(303) or flag_value
	return flag_value
end

--- Returns georama analysis flag 304.
function field_town_f03.get_analysis_flag_304()
	local flag_value: s32 = 0
	flag_value = event.get_georama_analysis_flag(304) or flag_value
	return flag_value
end

--- Plays the e456 cutscene in which the party points ahead and runs off.
function field_town_f03.play_event_e456()
	local playable_character: s32 = 0
	vm.section(function()
		event.set_save_flag(456, 1)
		event.initialize_event()
		event.set_message_window_mode(0, 7)
		event.assign_memory_stack(5)
		event.clear_memory_stack(5)
		playable_character = event.get_playable_character() or playable_character
		event.set_scene_status_flags(1, 0, 256, 1)
		event.change_directory("event/e400/e456/")
		event.load_message_file(0, 5, "e456_1.txt")
		if playable_character == 0 then
			event.load_character_motion_pack(5, "e456_mints.gltf", "info", 0)
			event.set_character_active(0)
			event.attach_object_handle_to_character(0, 0)
			event.clear_object_sequence(0)
			event.set_object_sequence_object(0, 0)
		end
		if playable_character == 1 then
			event.load_character_motion_pack(5, "e456_monica.gltf", "info", 0)
			event.set_character_active(0)
			event.attach_object_handle_to_character(1, 0)
			event.clear_object_sequence(1)
			event.set_object_sequence_object(1, 1)
		end
		event.change_directory("")
		if playable_character == 1 then
			event.load_character(5, "chara/c01_base.gltf", "info", 32)
			event.load_equipment_model(5, 0, 4, "info", 32)
			event.load_equipment_model(5, 0, 3, "info", 32)
			event.load_equipment_model(5, 0, 2, "info", 32, 33)
			event.load_character_motion_pack(5, "event/e400/e456/e456_mints.gltf", "info", 32)
			event.attach_object_handle_to_character(0, 32)
			event.clear_object_sequence(0)
			event.set_object_sequence_object(0, 0)
		else
