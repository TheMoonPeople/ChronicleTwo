--- Activates the town's characters numbered 307, 308 and 311 to 314 from georama analysis flags 305, 301, 302, 303 and 304.
function field_town_f03.update_character_activation()
	character.set_active_by_number(307, georama.is_analysis_flag_305_set())
	character.set_active_by_number(308, georama.is_analysis_flag_305_set())
	character.set_active_by_number(311, georama.is_analysis_flag_301_set())
	character.set_active_by_number(312, georama.is_analysis_flag_302_set())
	character.set_active_by_number(313, field_town_f03.get_analysis_flag_303())
	character.set_active_by_number(314, field_town_f03.get_analysis_flag_304())
end

return field_town_f03
