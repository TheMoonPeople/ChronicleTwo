--- Plays a voice line with its message window and closes the window when the line ends or the frame limit passes.
function palm_brinks_m06.play_voiced_message(voice_id: s32, max_frames: s32)
	event.open_voice_stream_wave(1, voice_id)
	sound.wait_voice_stream_ready(1)
	message.open(0, -1, 8, 0, 0)
	event.play_voice_stream(1)
	message.wait_voice_for(0, max_frames)
	message.close(0)
	event.close_voice_stream(1)
	event.set_message_bubble_screen_slot(0, 0)
end

return palm_brinks_m06
