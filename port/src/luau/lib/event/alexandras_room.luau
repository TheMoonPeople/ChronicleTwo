--- Shows a refusal message when the active character is the third or fourth playable one, otherwise asks the player to confirm and fades out on a negative answer, returning 1 when the scene is declined.
function alexandras_room.confirm_scene_start(prompt_index: s32)
	local active_character: s32 = 0
	local answer: any = 0
	local resume_point: number = 0
	return vm.guard(function()
		event.initialize_event()
		event.set_character_motion(0, "立ち")
		active_character = event.get_playable_character() or active_character
		if active_character == 2 or active_character == 3 then
			event.set_message_window_mode(0, 1)
			event.set_message_draw_speed(0, 1)
			if active_character == 2 then
				resume_point = 1
				message.show_and_wait(0, 20, 5, 256, 208)
			else
				resume_point = 2
				message.show_and_wait(0, 21, 5, 256, 208)
			end
			event.finish_event()
			return 0
		end
		resume_point = 3
		answer = message.ask_yes_no(prompt_index, -1)
		if answer == 0 then
			event.fade_out_screen(30)
			resume_point = 4
			wait.frames(30)
			event.finish_event()
			return 1
		end
		event.finish_event()
		return 0
	end, function(received: { any })
		if resume_point <= 2 then
			if resume_point <= 1 then
				message.show_and_wait_skipping(0, 21, 5, 256, 208)
			end
			return 0
		end
		if resume_point <= 4 then
			if resume_point == 3 then
				answer = received[1] :: number
			end
			if resume_point <= 3 then
				wait.frames_skipping(30)
			end
			return 1
		end
		return nil
	end)
end

