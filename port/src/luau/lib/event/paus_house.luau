--- Runs the player character into the scene while the camera tracks its upper body.
function paus_house.walk_player_in()
	local x: f32 = 0
	local y: f32 = 0
	local z: f32 = 0
	local frame: s32 = 0
	event.initialize_event()
	event.attach_object_handle_to_character(0, 0)
	event.set_object_handle_footstep_sound(0, 7)
	event.clear_object_sequence(0)
	event.set_object_sequence_object(0, 0)
	event.set_character_position(0, -243.29, 20.61, 67.87)
	event.set_character_rotation(0, 0.0, 1.09, 0.0)
	event.set_character_motion(0, "走り", 4)
	event.set_camera_position(-29.72, 46.19, 38.9)
	event.fade_in_screen(30)
	event.move_object_sequence(0, -191.2, 0.0, 97.7, 20)
	frame = 0
	while frame < 20 do
		do
			local out1, out2, out3 = event.get_character_position(0)
			x = out1 or x
			y = out2 or y
			z = out3 or z
		end
		y = vm.f32(y + 30.0)
		event.set_camera_look_at(x, y, z)
		frame = frame + 1
		vm.wait(1)
	end
	event.set_object_handle_footstep_sound(0, 0)
end

return paus_house
