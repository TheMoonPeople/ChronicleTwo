--- Holds a leftover look-height and frame-counter update with no engine effect.
function paus_house.advance_look_height_frame()
	local look_height: f32 = 0
	local frame: s32 = 0
	frame = 0
	look_height = vm.f32(look_height + 30.0)
	local _ = frame < 20
	frame = frame + 1
end

--- Asks a yes-or-no question and either runs out of the house with a fade-out or walks the character a few steps ahead.
function paus_house.ask_to_leave_house()
	local answer: any = 0
	local x: f32 = 0
	local y: f32 = 0
	local z: f32 = 0
	local target_x: f32 = 0
	local target_y: f32 = 0
	local target_z: f32 = 0
	local frame: s32 = 0
	local checkpoint: number = 0
	return vm.guard(function()
		event.initialize_event()
		event.set_character_motion(0, "立ち")
		checkpoint = 1
		answer = message.ask_yes_no(5, 2)
		event.attach_object_handle_to_character(0, 0)
		event.clear_object_sequence(0)
		event.set_object_sequence_object(0, 0)
		if answer == 0 then
			event.start_crossfade(10)
			event.set_camera_sequence_position(-165.74, 34.03, 218.78)
			event.set_camera_sequence_look_at(-253.92, 30.71, 96.73)
			event.set_object_sequence_position(0, -268.17, 20.61, 70.01)
			event.set_object_sequence_rotation(0, 0.0, -2.51, 0.0)
			event.set_object_sequence_motion(0, "走り", 4)
			event.move_object_sequence(0, -403.16, 20.61, -110.47, 50)
			checkpoint = 2
			wait.frames(30)
			event.fade_out_screen(20)
			checkpoint = 3
			wait.frames(20)
			return 1
		else
			do
				local out1, out2, out3 = event.get_character_position(0)
				x = out1 or x
				y = out2 or y
				z = out3 or z
			end
			target_x = vm.f32(vm.f32(vm.sin(vm.f32(1.33)) * 30.0) + x)
			target_y = 0.0
			target_z = vm.f32(vm.f32(vm.cos(vm.f32(1.33)) * 30.0) + z)
			event.move_object_sequence(0, target_x, target_y, target_z, 30)
			event.turn_object_sequence_toward(0, target_x, target_y, target_z, 10)
			event.set_object_sequence_motion(0, "歩き")
			frame = 0
			while frame < 30 do
				do
					local out1, out2, out3 = event.get_character_position(0)
					x = out1 or x
					y = out2 or y
					z = out3 or z
				end
				y = vm.f32(y + 30.0)
				event.set_camera_look_at(x, y, z)
				frame = frame + 1
				checkpoint = 4
				vm.wait(4)
			end
		end
		return 0
	end, function(received: { any })
		if checkpoint <= 3 then
			if checkpoint == 1 then
				answer = received[1] :: number
			end
			if checkpoint <= 1 then
				wait.frames_skipping(30)
			end
			if checkpoint <= 2 then
				wait.frames_skipping(20)
			end
			return 1
		end
		if checkpoint <= 4 then
			return 0
		end
		return nil
	end)
end

--- Turns the player character and a partner toward each other and runs their conversation line.
function paus_house.face_character_and_talk(partner: s32, talk_style: s32)
	local player_x: f32 = 0
	local player_y: f32 = 0
	local player_z: f32 = 0
	local partner_x: f32 = 0
	local partner_y: f32 = 0
	local partner_z: f32 = 0
	local player_yaw: f32 = 0
	local partner_yaw: f32 = 0
	local player_target_yaw: f32 = 0
	local partner_target_yaw: f32 = 0
	local needs_turn: s32 = 0
	event.attach_object_handle_to_character(0, 0)
	event.clear_object_sequence(0)
	event.set_object_sequence_object(0, 0)
	event.attach_object_handle_to_character(1, partner)
	event.clear_object_sequence(1)
	event.set_object_sequence_object(1, 1)
	do
		local out1, out2, out3 = event.get_character_position(0)
		player_x = out1 or player_x
		player_y = out2 or player_y
		player_z = out3 or player_z
	end
	do
		local _, out2, _ = event.get_character_rotation(0)
		player_yaw = out2 or player_yaw
	end
	do
		local out1, out2, out3 = event.get_character_position(partner)
		partner_x = out1 or partner_x
		partner_y = out2 or partner_y
		partner_z = out3 or partner_z
	end
	do
		local _, out2, _ = event.get_character_rotation(partner)
		partner_yaw = out2 or partner_yaw
	end
	player_target_yaw = event.get_direction_angle(player_x, player_y, player_z, partner_x, partner_y, partner_z) or player_target_yaw
	partner_target_yaw = event.get_direction_angle(partner_x, partner_y, partner_z, player_x, player_y, player_z) or partner_target_yaw
	needs_turn = event.compare_angles(player_yaw, player_target_yaw, 0.1) or needs_turn
	if needs_turn ~= 0 then
		event.rotate_object_sequence(0, 0.0, player_target_yaw, 0.0, 10)
		event.set_object_sequence_motion(0, "歩き")
		event.delay_object_sequence_motion_track(0, 10)
	end
	event.set_object_sequence_motion(0, "立ち")
	needs_turn = event.compare_angles(partner_yaw, partner_target_yaw, 0.1) or needs_turn
	if needs_turn ~= 0 then
		event.rotate_object_sequence(1, 0.0, partner_target_yaw, 0.0, 10)
		event.set_object_sequence_motion(1, "歩き")
		event.delay_object_sequence_motion_track(1, 10)
	end
	event.set_object_sequence_motion(1, "立ち")
	wait.frames(20)
	if talk_style == 0 then
		event.set_mouth_motions(1, "会話", 0, "立ち", 0)
	end
	if talk_style == 1 then
		event.set_mouth_motions(1, "慌て会話", 0, "立ち", 0)
	end
	message.say_bubble(0, -1, partner, 0, 0)
	needs_turn = event.compare_angles(partner_yaw, partner_target_yaw, 0.1) or needs_turn
	if needs_turn ~= 0 then
		event.rotate_object_sequence(1, 0.0, partner_yaw, 0.0, 10)
		event.set_object_sequence_motion(1, "歩き")
		event.delay_object_sequence_motion_track(1, 10)
	end
	event.set_object_sequence_motion(1, "立ち")
	wait.frames(11)
end

--- Places Pau and Shigu and the map parts they use according to the story flags.
function paus_house.place_residents()
	local story_flag_500: s32 = 0
	local quest_status: s32 = 0
	local e408_played: s32 = 0
	local e420_played: s32 = 0
	local e438_played: s32 = 0
	local story_flag_444: s32 = 0
	story_flag_500 = event.get_save_flag(500) or story_flag_500
	if story_flag_500 ~= 0 then
		quest_status = event.get_quest_request_status(0, 5) or quest_status
		if quest_status ~= 2 then
			event.assign_memory_stack(4)
			event.clear_memory_stack(4)
			event.load_character(4, "event/e400/e438/e438_paw.gltf", "info", 8)
			event.set_character_active(1, 8)
			event.set_character_position(8, -37.0, 0.0, 111.25)
			event.set_character_rotation(8, 0.0, -0.97, 0.0)
			event.set_character_motion(8, "立ち", 4)
			event.set_scene_character_number(8, 9)
		end
		event.set_function_point_enabled("", "event_400", 0)
		event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_03-a0")
		event.set_object_handle_visible(0, 0)
		event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_02-c0")
		event.set_object_handle_visible(0, 0)
		return
	end
	e408_played = event.get_save_flag(408) or e408_played
	e420_played = event.get_save_flag(420) or e420_played
	e438_played = event.get_save_flag(438) or e438_played
	story_flag_444 = event.get_save_flag(444) or story_flag_444
	event.set_function_point_enabled("", "event_400", 0)
	event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_03-a0")
	event.set_object_handle_visible(0, 0)
	event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_02-c0")
	event.set_object_handle_visible(0, 0)
	if e408_played == 1 then
		event.assign_memory_stack(4)
		event.clear_memory_stack(4)
		event.load_character(4, "event/e400/e438/e438_paw.gltf", "info", 8)
		event.set_character_active(1, 8)
		event.set_character_position(8, -37.0, 0.0, 111.25)
		event.set_character_rotation(8, 0.0, -0.97, 0.0)
		event.set_character_motion(8, "立ち", 4)
		event.set_scene_character_number(8, 9)
		if e420_played == 1 and story_flag_444 == 0 then
			event.load_character(4, "event/e400/e438/e438_shigu.gltf", "info", 9)
			event.set_character_active(1, 9)
			event.set_character_position(9, -86.0, 0.0, 34.0)
			event.set_character_rotation(9, 0.0, 2.52, 0.0)
			event.set_character_motion(9, "座り", 4)
			event.set_character_texture_animation(9, 0)
			if e438_played == 0 then
				event.set_character_texture_animation(9, 1, "目とじ")
			else
				event.attach_object_handle_to_character(0, 9)
				event.set_object_handle_frame_visible(0, "grid1", 0)
				event.set_character_texture_animation(9, 1, "通常目パチ")
			end
			event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_03-a0")
			event.set_object_handle_position(0, -86.0, 0.0, 34.0)
			event.set_object_handle_rotation(0, 0.0, 2.52, 0.0)
			event.set_object_handle_visible(0, 1)
			event.attach_object_handle_to_map_part_3(0, "p01_s2701", "s2701_02-c0")
			event.set_object_handle_position(0, -86.0, 0.0, 34.0)
			event.set_object_handle_rotation(0, 0.0, 2.52, 0.0)
			event.set_object_handle_visible(0, 1)
			event.set_function_point_enabled("", "event_400", 1)
		end
	end
end

