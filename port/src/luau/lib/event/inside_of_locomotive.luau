--- Enables or disables the locomotive function points and stops the environment music.
function inside_of_locomotive.set_function_points_enabled(enabled: s32)
	event.set_function_point_enabled("", "flame-1", enabled)
	event.set_function_point_enabled("", "func", enabled)
	event.set_function_point_enabled("", "func0", enabled)
	event.set_function_point_enabled("", "func1", enabled)
	event.set_function_point_enabled("", "func2", enabled)
	event.set_function_point_enabled("", "func3", enabled)
	event.set_function_point_enabled("", "func4", enabled)
	event.set_function_point_enabled("", "func5", enabled)
	event.set_function_point_enabled("", "func8", enabled)
	event.stop_environment_music()
end

--- Shows or hides the two cabin characters depending on the story flags.
function inside_of_locomotive.show_characters_by_progress()
	local flag_202: s32 = 0
	local flag_204: s32 = 0
	flag_202 = event.get_save_flag(202) or flag_202
	flag_204 = event.get_save_flag(204) or flag_204
	if flag_202 == 1 and flag_204 == 0 then
		event.set_character_active(1, 122)
		event.set_character_active(1, 123)
	else
		event.set_character_active(0, 122)
		event.set_character_active(0, 123)
	end
end

