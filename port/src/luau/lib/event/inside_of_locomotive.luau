--!strict
--- Cutscene pieces and setup for the Inside of Locomotive map.

local vm = require("@lib/vm")
local camera = vm.module("@lib/event/camera")
local message = vm.module("@lib/event/message")
local wait = vm.module("@lib/event/wait")

local inside_of_locomotive = {}

--- Deletes the cabin scene characters and reactivates the player.
function inside_of_locomotive.delete_collapse_scene_characters()
	event.delete_character(32)
	event.delete_character(33)
	event.delete_character(34)
	event.set_character_active(1, 0)
end

--- Disables saving and prints a debug marker.
function inside_of_locomotive.disable_saving()
	local flag_203: s32 = 0
	local flag_204: s32 = 0
	flag_203 = event.get_save_flag(203) or flag_203
	flag_204 = event.get_save_flag(204) or flag_204
	if flag_203 == 1 and flag_204 == 0 then
		event.set_save_control_bits(1, 1)
	else
		event.set_save_control_bits(1, 1)
	end
	print("off----\n")
end

--- Fades in the scene, sets the characters' idle poses and pans the camera.
function inside_of_locomotive.fade_in_and_pan_camera(sound_id: any)
	event.fade_in_screen(30)
	wait.frames(30)
	event.set_object_sequence_motion(0, "上見立ち", 4)
	event.reset_object_sequence_dynamic_animation(0)
	event.set_object_sequence_motion(1, "腰に手", 4)
	event.set_object_sequence_motion(2, "斜め向き立ち", 4)
	event.set_object_sequence_motion(3, "石炭", 4)
	event.move_camera_sequence_eased(41.03, 65.52, -72.49, 1.22, 60.93, 25.12, 60, 0, 1.0)
	camera.wait_until_done()
	wait.frames(20)
end

